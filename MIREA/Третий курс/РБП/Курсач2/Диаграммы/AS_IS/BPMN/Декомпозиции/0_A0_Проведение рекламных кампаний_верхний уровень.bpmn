<?xml version='1.0' encoding='UTF8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A0" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Клиентские контакты (файл Excel)" isUnlimited="true"/>
  <bpmn:dataStore id="Store_MailingLog" name="Журнал email-рассылок (файл Excel)" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Архив документов кампаний" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CorporateMail" name="Архив корпоративной переписки" isUnlimited="true"/>
  <bpmn:process id="Process_A0" name="Проведение рекламных кампаний — верхний уровень" isExecutable="false">
    <bpmn:documentation>Учебная модель существующей ручной технологии. Входы данного уровня поступают из родительского процесса, смежных участников и постоянных файлов; происхождение указано в названиях и описаниях. Файл не предназначен для исполнения в движке.</bpmn:documentation>
    <bpmn:startEvent id="A0_Start" name="Возникла потребность в проведении рекламной кампании">
      <bpmn:outgoing>A0_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="A0_Prep" name="Подготовить рекламную кампанию">
      <bpmn:incoming>A0_F1</bpmn:incoming>
      <bpmn:outgoing>A0_F2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="A0_Gprep" name="Результат подготовки?" gatewayDirection="Diverging">
      <bpmn:incoming>A0_F2</bpmn:incoming>
      <bpmn:outgoing>A0_F3</bpmn:outgoing>
      <bpmn:outgoing>A0_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="A0_Mdev" name="" gatewayDirection="Converging">
      <bpmn:incoming>A0_F4</bpmn:incoming>
      <bpmn:incoming>A0_F10</bpmn:incoming>
      <bpmn:outgoing>A0_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="A0_Dev" name="Разработать рекламную кампанию">
      <bpmn:incoming>A0_F5</bpmn:incoming>
      <bpmn:outgoing>A0_F6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="A0_Run" name="Запустить и сопровождать рекламную кампанию">
      <bpmn:incoming>A0_F6</bpmn:incoming>
      <bpmn:outgoing>A0_F7</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="A0_Grun" name="Результат сопровождения?" gatewayDirection="Diverging">
      <bpmn:incoming>A0_F7</bpmn:incoming>
      <bpmn:outgoing>A0_F8</bpmn:outgoing>
      <bpmn:outgoing>A0_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="A0_Eval" name="Оценить результаты рекламной кампании">
      <bpmn:incoming>A0_F8</bpmn:incoming>
      <bpmn:outgoing>A0_F9</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="A0_End" name="Итоговый отчёт сформирован и передан">
      <bpmn:incoming>A0_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="A0_Refusal" name="Оформлено решение об отказе">
      <bpmn:incoming>A0_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A0_F1" sourceRef="A0_Start" targetRef="A0_Prep"/>
    <bpmn:sequenceFlow id="A0_F2" sourceRef="A0_Prep" targetRef="A0_Gprep"/>
    <bpmn:sequenceFlow id="A0_F3" sourceRef="A0_Gprep" targetRef="A0_Refusal" name="Отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Отказ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A0_F4" sourceRef="A0_Gprep" targetRef="A0_Mdev" name="Бриф сформирован">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Бриф сформирован</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A0_F5" sourceRef="A0_Mdev" targetRef="A0_Dev"/>
    <bpmn:sequenceFlow id="A0_F6" sourceRef="A0_Dev" targetRef="A0_Run"/>
    <bpmn:sequenceFlow id="A0_F7" sourceRef="A0_Run" targetRef="A0_Grun"/>
    <bpmn:sequenceFlow id="A0_F8" sourceRef="A0_Grun" targetRef="A0_Eval" name="Период завершён">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Период завершён</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A0_F9" sourceRef="A0_Eval" targetRef="A0_End"/>
    <bpmn:sequenceFlow id="A0_F10" sourceRef="A0_Grun" targetRef="A0_Mdev" name="Нужно повторное согласование">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно повторное согласование</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="A0_ResourcesNote">
      <bpmn:text>Средства и исполнители раскрыты в детализациях подпроцессов.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A0_ResourcesNote_Association" sourceRef="A0_ResourcesNote" targetRef="A0_Prep" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_A0">
    <bpmn:participant id="Participant_A0" name="Департамент маркетинга и рекламы" processRef="Process_A0"/>
  </bpmn:collaboration>
