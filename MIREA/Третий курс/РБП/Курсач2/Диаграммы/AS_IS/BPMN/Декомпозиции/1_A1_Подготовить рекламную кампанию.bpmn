<?xml version='1.0' encoding='UTF8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A1" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Клиентские контакты (файл Excel)" isUnlimited="true"/>
  <bpmn:dataStore id="Store_MailingLog" name="Журнал email-рассылок (файл Excel)" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Архив документов кампаний" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CorporateMail" name="Архив корпоративной переписки" isUnlimited="true"/>
  <bpmn:process id="Process_A1" name="Подготовить рекламную кампанию" isExecutable="false">
    <bpmn:documentation>Учебная модель существующей ручной технологии. Входы данного уровня поступают из родительского процесса, смежных участников и постоянных файлов; происхождение указано в названиях и описаниях. Файл не предназначен для исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="A1_LaneSet">
      <bpmn:lane id="A1_Lane_R1" name="Директор департамента маркетинга и рекламы">
        <bpmn:flowNodeRef>A1_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_G11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_Refusal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A1_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A1_M13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_G13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_A14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A1_Start" name="Возникла потребность в кампании">
      <bpmn:outgoing>A1_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A1_A11" name="Определить потребность в рекламной кампании">
      <bpmn:documentation>Функция A11. 
Исполнитель: Директор департамента маркетинга и рекламы.
Средства: Персональный компьютер.
Входы: Сведения о потребности в рекламной кампании.
Результаты: Решение о проведении кампании; Решение об отказе от проведения кампании.
Основания: Маркетинговая стратегия; Регламент проведения и согласования кампаний; План продвижения.</bpmn:documentation>
      <bpmn:incoming>A1_F1</bpmn:incoming>
      <bpmn:outgoing>A1_F2</bpmn:outgoing>
      <bpmn:ioSpecification id="A1_A11_IO">
        <bpmn:dataInput id="A1_Data_1_Item" name="Сведения о потребности [из планирования]"/>
        <bpmn:dataOutput id="A1_Data_9_Item" name="Решение о проведении / отказе"/>
        <bpmn:inputSet id="A1_A11_InputSet">
          <bpmn:dataInputRefs>A1_Data_1_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A1_A11_OutputSet">
          <bpmn:dataOutputRefs>A1_Data_9_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A1_Data_1">
        <bpmn:sourceRef>A1_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_1_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_9">
        <bpmn:sourceRef>A1_Data_9_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Doc6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A1_A11_Performer">
        <bpmn:resourceRef>Resource_R1</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A1_G11" name="Проводить кампанию?" gatewayDirection="Diverging">
      <bpmn:incoming>A1_F2</bpmn:incoming>
      <bpmn:outgoing>A1_F3</bpmn:outgoing>
      <bpmn:outgoing>A1_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A1_A12" name="Сформировать задачу на проведение рекламной кампании">
      <bpmn:documentation>Функция A12. Директор оформляет задачу в Word и направляет менеджеру через почтовый клиент и корпоративную почту.
Исполнитель: Директор департамента маркетинга и рекламы.
Средства: Персональный компьютер; Word; Почтовый клиент; Корпоративная почта.
Входы: .
Результаты: Задача на проведение рекламной кампании.
Основания: Утверждённый бюджетный лимит; Утверждённые коммерческие условия акции; Регламент проведения и согласования кампаний; Шаблоны документов кампании; Решение о проведении кампании.</bpmn:documentation>
      <bpmn:incoming>A1_F3</bpmn:incoming>
      <bpmn:outgoing>A1_F5</bpmn:outgoing>
      <bpmn:ioSpecification id="A1_A12_IO">
        <bpmn:dataInput id="A1_Data_10_Item" name="Решение о проведении / отказе"/>
        <bpmn:dataOutput id="A1_Data_2_Item" name="Задача на проведение кампании"/>
        <bpmn:dataOutput id="A1_Data_11_Item" name="Архив документов кампаний"/>
        <bpmn:dataOutput id="A1_Data_13_Item" name="Архив корпоративной переписки"/>
        <bpmn:inputSet id="A1_A12_InputSet">
          <bpmn:dataInputRefs>A1_Data_10_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A1_A12_OutputSet">
          <bpmn:dataOutputRefs>A1_Data_2_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A1_Data_11_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A1_Data_13_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A1_Data_10">
        <bpmn:sourceRef>A1_Doc6</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_10_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_2">
        <bpmn:sourceRef>A1_Data_2_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Doc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_11">
        <bpmn:sourceRef>A1_Data_11_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Store7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_13">
        <bpmn:sourceRef>A1_Data_13_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Store8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A1_A12_Performer">
        <bpmn:resourceRef>Resource_R1</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="A1_Refusal" name="Решение об отказе оформлено">
      <bpmn:incoming>A1_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="A1_M13" name="" gatewayDirection="Converging">
      <bpmn:incoming>A1_F5</bpmn:incoming>
      <bpmn:incoming>A1_F10</bpmn:incoming>
      <bpmn:outgoing>A1_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A1_A13" name="Собрать исходные данные">
      <bpmn:documentation>Функция A13. Запросы и уточнения направляет менеджер по почте. Категорийный менеджер предоставляет сведения; требования каналов поступают от digital-специалиста и trade-маркетолога. Данные сводятся в Excel.
Исполнитель: Менеджер рекламной кампании.
Средства: Персональный компьютер; Excel; Почтовый клиент; Корпоративная почта.
Входы: Исходные коммерческие данные.
Результаты: Сводные исходные данные.
Основания: Технические требования каналов размещения; Регламент проведения и согласования кампаний; Шаблоны документов кампании; Задача на проведение рекламной кампании.</bpmn:documentation>
      <bpmn:incoming>A1_F6</bpmn:incoming>
      <bpmn:outgoing>A1_F7</bpmn:outgoing>
      <bpmn:ioSpecification id="A1_A13_IO">
        <bpmn:dataInput id="A1_Data_3_Item" name="Задача на проведение кампании"/>
        <bpmn:dataInput id="A1_Data_5_Item" name="Исходные коммерческие данные [ответ коммерческого блока]"/>
        <bpmn:dataInput id="A1_Data_14_Item" name="Архив корпоративной переписки"/>
        <bpmn:dataOutput id="A1_Data_6_Item" name="Сводные исходные данные (Excel)"/>
        <bpmn:dataOutput id="A1_Data_15_Item" name="Архив корпоративной переписки"/>
        <bpmn:inputSet id="A1_A13_InputSet">
          <bpmn:dataInputRefs>A1_Data_3_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A1_Data_5_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A1_Data_14_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A1_A13_OutputSet">
          <bpmn:dataOutputRefs>A1_Data_6_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A1_Data_15_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A1_Data_3">
        <bpmn:sourceRef>A1_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_3_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A1_Data_5">
        <bpmn:sourceRef>A1_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_5_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A1_Data_14">
        <bpmn:sourceRef>A1_Store8</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_14_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_6">
        <bpmn:sourceRef>A1_Data_6_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Doc4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_15">
        <bpmn:sourceRef>A1_Data_15_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Store8</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A1_A13_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A1_G13" name="Данные полны и проверены?" gatewayDirection="Diverging">
      <bpmn:incoming>A1_F7</bpmn:incoming>
      <bpmn:outgoing>A1_F8</bpmn:outgoing>
      <bpmn:outgoing>A1_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A1_A14" name="Сформировать бриф рекламной кампании">
      <bpmn:documentation>Функция A14. Менеджер формирует бриф в Word по задаче и сводным данным Excel.
Исполнитель: Менеджер рекламной кампании.
Средства: Персональный компьютер; Word.
Входы: Сводные исходные данные.
Результаты: Бриф рекламной кампании.
Основания: Утверждённый бюджетный лимит; Утверждённые коммерческие условия акции; Брендбук; Технические требования каналов размещения; Шаблоны документов кампании; Задача на проведение рекламной кампании.</bpmn:documentation>
      <bpmn:incoming>A1_F8</bpmn:incoming>
      <bpmn:outgoing>A1_F9</bpmn:outgoing>
      <bpmn:ioSpecification id="A1_A14_IO">
        <bpmn:dataInput id="A1_Data_4_Item" name="Задача на проведение кампании"/>
        <bpmn:dataInput id="A1_Data_7_Item" name="Сводные исходные данные (Excel)"/>
        <bpmn:dataOutput id="A1_Data_8_Item" name="Бриф рекламной кампании (Word)"/>
        <bpmn:dataOutput id="A1_Data_12_Item" name="Архив документов кампаний"/>
        <bpmn:inputSet id="A1_A14_InputSet">
          <bpmn:dataInputRefs>A1_Data_4_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A1_Data_7_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A1_A14_OutputSet">
          <bpmn:dataOutputRefs>A1_Data_8_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A1_Data_12_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A1_Data_4">
        <bpmn:sourceRef>A1_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_4_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A1_Data_7">
        <bpmn:sourceRef>A1_Doc4</bpmn:sourceRef>
        <bpmn:targetRef>A1_Data_7_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_8">
        <bpmn:sourceRef>A1_Data_8_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Doc5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A1_Data_12">
        <bpmn:sourceRef>A1_Data_12_Item</bpmn:sourceRef>
        <bpmn:targetRef>A1_Store7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A1_A14_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="A1_End" name="Бриф сформирован">
      <bpmn:incoming>A1_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="A1_Doc1_Object" name="Сведения о потребности [из планирования]"/>
    <bpmn:dataObjectReference id="A1_Doc1" name="Сведения о потребности [из планирования]" dataObjectRef="A1_Doc1_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A1_Doc2_Object" name="Задача на проведение кампании"/>
    <bpmn:dataObjectReference id="A1_Doc2" name="Задача на проведение кампании" dataObjectRef="A1_Doc2_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A1_Doc3_Object" name="Исходные коммерческие данные [ответ коммерческого блока]"/>
    <bpmn:dataObjectReference id="A1_Doc3" name="Исходные коммерческие данные [ответ коммерческого блока]" dataObjectRef="A1_Doc3_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A1_Doc4_Object" name="Сводные исходные данные (Excel)"/>
    <bpmn:dataObjectReference id="A1_Doc4" name="Сводные исходные данные (Excel)" dataObjectRef="A1_Doc4_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A1_Doc5_Object" name="Бриф рекламной кампании (Word)"/>
    <bpmn:dataObjectReference id="A1_Doc5" name="Бриф рекламной кампании (Word)" dataObjectRef="A1_Doc5_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A1_Doc6_Object" name="Решение о проведении / отказе"/>
    <bpmn:dataObjectReference id="A1_Doc6" name="Решение о проведении / отказе" dataObjectRef="A1_Doc6_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="A1_Store7" name="Архив документов кампаний" dataStoreRef="Store_CampaignDocuments">
      <bpmn:documentation>Постоянное раздельное хранилище; существует до текущей кампании.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="A1_Store8" name="Архив корпоративной переписки" dataStoreRef="Store_CorporateMail">
      <bpmn:documentation>Постоянное раздельное хранилище; существует до текущей кампании.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="A1_F1" sourceRef="A1_Start" targetRef="A1_A11"/>
    <bpmn:sequenceFlow id="A1_F2" sourceRef="A1_A11" targetRef="A1_G11"/>
    <bpmn:sequenceFlow id="A1_F3" sourceRef="A1_G11" targetRef="A1_A12" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A1_F4" sourceRef="A1_G11" targetRef="A1_Refusal" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A1_F5" sourceRef="A1_A12" targetRef="A1_M13"/>
    <bpmn:sequenceFlow id="A1_F6" sourceRef="A1_M13" targetRef="A1_A13"/>
    <bpmn:sequenceFlow id="A1_F7" sourceRef="A1_A13" targetRef="A1_G13"/>
    <bpmn:sequenceFlow id="A1_F8" sourceRef="A1_G13" targetRef="A1_A14" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A1_F9" sourceRef="A1_A14" targetRef="A1_End"/>
    <bpmn:sequenceFlow id="A1_F10" sourceRef="A1_G13" targetRef="A1_M13" name="Нужно уточнение">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нужно уточнение</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="A1_ResourcesNote">
      <bpmn:text>Средства труда: Персональный компьютер; Excel; Word; Почтовый клиент; Корпоративная почта.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A1_ResourcesNote_Association" sourceRef="A1_ResourcesNote" targetRef="A1_A11" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_A1">
    <bpmn:participant id="Participant_A1" name="Департамент маркетинга и рекламы" processRef="Process_A1"/>
    <bpmn:participant id="Participant_S1" name="Коммерческий блок — Категорийный менеджер">
      <bpmn:documentation>Смежный участник. Внутренние операции не показаны.</bpmn:documentation>
