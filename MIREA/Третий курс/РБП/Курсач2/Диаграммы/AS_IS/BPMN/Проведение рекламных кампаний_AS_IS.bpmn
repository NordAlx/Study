        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A2_Data_16">
          <bpmn:sourceRef>A2_Doc5</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_16_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
