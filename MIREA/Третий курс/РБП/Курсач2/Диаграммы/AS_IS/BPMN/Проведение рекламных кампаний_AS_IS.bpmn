          <bpmn:targetRef>A4_Doc5</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A4_Data_10">
          <bpmn:sourceRef>A4_Data_10_Item</bpmn:sourceRef>
          <bpmn:targetRef>A4_Store6</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:dataOutputAssociation id="A4_Data_12">
          <bpmn:sourceRef>A4_Data_12_Item</bpmn:sourceRef>
          <bpmn:targetRef>A4_Store7</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
        <bpmn:performer id="A4_A43_Performer">
          <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
        </bpmn:performer>
      </bpmn:task>
