          </bpmn:outputSet>
        </bpmn:ioSpecification>
        <bpmn:dataInputAssociation id="A2_Data_3">
          <bpmn:sourceRef>A2_Doc1</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_3_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A2_Data_7">
          <bpmn:sourceRef>A2_Doc2</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_7_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A2_Data_9">
          <bpmn:sourceRef>A2_Doc3</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_9_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A2_Data_17">
          <bpmn:sourceRef>A2_Doc5</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_17_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataInputAssociation id="A2_Data_22">
          <bpmn:sourceRef>A2_Doc9</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_22_Item</bpmn:targetRef>
