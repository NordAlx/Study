          <bpmn:dataOutput id="A2_Data_26_Item" name="Архив документов кампаний"/>
          <bpmn:inputSet id="A2_A22_InputSet">
            <bpmn:dataInputRefs>A2_Data_2_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_6_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_16_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_21_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_25_Item</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="A2_A22_OutputSet">
            <bpmn:dataOutputRefs>A2_Data_8_Item</bpmn:dataOutputRefs>
            <bpmn:dataOutputRefs>A2_Data_26_Item</bpmn:dataOutputRefs>
          </bpmn:outputSet>
