          <bpmn:dataOutput id="A2_Data_12_Item" name="Рекламные материалы [до согласования]"/>
          <bpmn:dataOutput id="A2_Data_28_Item" name="Архив документов кампаний"/>
          <bpmn:inputSet id="A2_A23_InputSet">
            <bpmn:dataInputRefs>A2_Data_3_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_7_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_9_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_17_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_22_Item</bpmn:dataInputRefs>
            <bpmn:dataInputRefs>A2_Data_27_Item</bpmn:dataInputRefs>
