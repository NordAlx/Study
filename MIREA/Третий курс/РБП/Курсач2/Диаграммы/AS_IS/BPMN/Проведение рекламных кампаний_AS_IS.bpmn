          <bpmn:dataInput id="A2_Data_14_Item" name="Рекламные материалы [до согласования]"/>
          <bpmn:dataInput id="A2_Data_31_Item" name="Архив корпоративной переписки"/>
          <bpmn:dataOutput id="A2_Data_15_Item" name="Замечания к медиаплану и материалам"/>
          <bpmn:dataOutput id="A2_Data_18_Item" name="Согласованный медиаплан"/>
          <bpmn:dataOutput id="A2_Data_19_Item" name="Согласованные рекламные материалы"/>
          <bpmn:dataOutput id="A2_Data_20_Item" name="Решение о согласовании"/>
          <bpmn:dataOutput id="A2_Data_32_Item" name="Архив корпоративной переписки"/>
          <bpmn:inputSet id="A2_A24_InputSet">
