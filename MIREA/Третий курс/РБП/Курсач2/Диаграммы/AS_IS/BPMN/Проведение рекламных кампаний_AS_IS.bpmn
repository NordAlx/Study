        <bpmn:dataInputAssociation id="A2_Data_23">
          <bpmn:sourceRef>A2_Store10</bpmn:sourceRef>
          <bpmn:targetRef>A2_Data_23_Item</bpmn:targetRef>
        </bpmn:dataInputAssociation>
        <bpmn:dataOutputAssociation id="A2_Data_5">
