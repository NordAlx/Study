;" edge="1" parent="1" source="epc_AS_IS_A3_db16a92f_3dbc_4793_a9a8_c8731e626f80" target="epc_AS_IS_A3_20135f27_84d0_481a_8124_d63316ec3d0c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="1285.0"/><mxPoint x="800.0" y="1463.0"/></Array></mxGeometry></mxCell><mxCell id="epc_AS_IS_A3_edge_6" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A3_1b32b019_de4a_4a7b_8ce1_cc289ca87054" target="epc_AS_IS_A3_db16a92f_3dbc_4793_a9a8_c8731e626f80"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="672.0"/><mxPoint x="800.0" y="1227.0"/></Array></mxGeometry></mxCell><mxCell id="title_3_A3_eEPC_AS_IS" value="A3 — Запустить и сопровождать рекламную кампанию • AS IS" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="80" y="15" width="1600" height="50" as="geometry"/></mxCell><mxCell id="legend_3_A3_eEPC_AS_IS" value="eEPC: событие — шестиугольник; функция — скруглённый прямоугольник; XOR/AND — круг.&#10;Эллипс — исполнитель; прямоугольник с боковыми полосами — программа; документ — информационный объект. Сплошные стрелки — поток процесса; пунктир — дополнительные связи. Повторяющиеся ресурсы обозначают один и тот же объект." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="3518.0" width="1600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>