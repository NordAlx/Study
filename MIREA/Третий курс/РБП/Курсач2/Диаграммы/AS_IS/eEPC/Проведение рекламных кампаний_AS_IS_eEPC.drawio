xGeometry></mxCell><mxCell id="epc_AS_IS_A0_edge_12" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A0_fb46edfb_8e99_476c_a64b_d5023686f181" target="epc_AS_IS_A0_0bbbedc4_5d46_4e80_874e_e2d0a49766f2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="2046.0"/><mxPoint x="800.0" y="2204.0"/></Array></mxGeometry></mxCell><mxCell id="epc_AS_IS_A0_edge_8" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A0_3e615b67_2fac_4de0_84c5_71e24260ae15" target="epc_AS_IS_A0_0bb7a879_657f_447c_9a6a_86444c3965d6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="1464.0"/><mxPoint x="800.0" y="1623.0"/></Array></mxGeometry></mxCell><mxCell id="title_0_A0_eEPC_AS_IS" value="A0 — Проведение рекламных кампаний • AS IS" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="80" y="15" width="1600" height="50" as="geometry"/></mxCell><mxCell id="legend_0_A0_eEPC_AS_IS" value="eEPC: событие — шестиугольник; функция — скруглённый прямоугольник; XOR/AND — круг.&#10;Эллипс — исполнитель; прямоугольник с боковыми полосами — программа; документ — информационный объект. Сплошные стрелки — поток процесса; пунктир — дополнительные связи. Повторяющиеся ресурсы обозначают один и тот же объект." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="2338" width="1600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="epc_AS_IS_A1" name="A1 — Подготовить рекламную кампанию"><mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="epc_AS_IS_A1_2d468efb_55a0_4814_8439_a8a9abde1131" label="Возникла потребность в&#10;проведении рекламной кампании" epc-kind="event" source-id="2d468efb-55a0-4814-8439-a8a9abde1131" original-label="Возникла потребность в проведении рекламной кампании" description=""><mxCell style="shape=hexagon;size=.10;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680.0" y="106.0" width="240" height="60" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A1_3803aff1_3743_4138_8948_c2c08bd3bcf8" label="Определить потребность в&#10;рекламной кампании" epc-kind="function" source-id="3803aff1-3743-4138-8948-c2c08bd3bcf8" original-label="Определить потребность в рекламной кампании" description="Функция A11. Входы: Сведения о потребности в рекламной кампании. Результаты: Решение о проведении кампании; Решение об отказе от проведения кампании. Обеспечение (атомарно): Директор департамента маркетинга и рекламы; Персональный компьютер. Управление: Маркетинговая стратегия; Регламент проведения и согласования кампаний; План продвижения."><mxCell style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#D5E8D4;strokeColor=#609E60;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680.0" y="222.0" width="240" height="66" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A1_b9d7d4d2_2787_419d_93f1_3906290fcbe1_at_1" label="План продвижения" epc-kind="data" source-id="b9d7d4d2-2787-419d-93f1-3906290fcbe1" original-label="План продвижения" description=""><mxCell style="shape=document;size=.12;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyl