оварах; Требования к обработке персональных данных."><mxCell style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#D5E8D4;strokeColor=#609E60;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680.0" y="1732.0" width="240" height="66" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A2_83e3bda6_8f36_4255_b3a0_0f7d73cfb7d3_at_21" label="Корпоративная почта" epc-kind="application" source-id="83e3bda6-8f36-4255-b3a0-0f7d73cfb7d3" original-label="Корпоративная почта" description=""><mxCell style="shape=process;size=.06;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="405.0" y="1670.0" width="230" height="30" as="geometry"/></mxCell></UserObject><mxCell id="epc_AS_IS_A2_edge_30" style="html=1;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;dashPattern=3 3;endArrow=none;endFill=0;endSize=6;rounded=0;curved=0;exitX=1;exitY=0.5;entryX=0;entryY=0.16666666666666666;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A2_83e3bda6_8f36_4255_b3a0_0f7d73cfb7d3_at_21" target="epc_AS_IS_A2_09c86f4a_d9be_4656_bf68_f9ced759b9b3"><mxGeometry relative="1" as="geometry"/></mxCell><UserObject id="epc_AS_IS_A2_19fccdc1_2ed5_4f07_ba73_04123ca2dc33_at_22" label="Почтовый клиент" epc-kind="application" source-id="19fccdc1-2ed5-4f07-ba73-04123ca2dc33" original-label="Почтовый клиент" description=""><mxCell style="shape=process;size=.06;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="405.0" y="1708.0" width="230" height="30" as="geometry"/></mxCell></UserObject><mxCell id="epc_AS_IS_A2_edge_29" style="html=1;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;dashPattern=3 3;endA