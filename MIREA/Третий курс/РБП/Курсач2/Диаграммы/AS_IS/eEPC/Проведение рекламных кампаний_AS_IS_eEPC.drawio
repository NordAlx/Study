18" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A3_20135f27_84d0_481a_8124_d63316ec3d0c" target="epc_AS_IS_A3_231047d2_b2f7_4668_89d4_b2c3ee95f17d"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="1553.0"/><mxPoint x="800.0" y="1718.0"/></Array></mxGeometry></mxCell><mxCell id="epc_AS_IS_A3_edge_0" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A3_db16a92f_3dbc_4793_a9a8_c8731e626f80" target="epc_AS_IS_A3_20135f27_84d0_481a_8124_d63316ec3d0c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="1285.0"/><mxPoint x="800.0" y="1463.0"/></Array></mxGeometry></mxCell><mxCell id="epc_AS_IS_A3_edge_6" style="html=1;strokeColor=#343B44;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;rounded=0;curved=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A3_1b32b019_de4a_4a7b_8ce1_cc289ca87054" target="epc_AS_IS_A3_db16a92f_3dbc_4793_a9a8_c8731e626f80"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800.0" y="672.0"/><mxPoint x="800.0" y="1227.0"/></Array></mxGeometry></mxCell><mxCell id="title_3_A3_eEPC_AS_IS" value="A3 — Запустить и сопровождать рекламную кампанию • AS IS" style="text;html=1;align=left;fontSize=26;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="80" y="15" width="1600" height="50" as="geometry"/></mxCell><mxCell id="legend_3_A3_eEPC_AS_IS" value="eEPC: событие — шестиугольник; функция — скруглённый прямоугольник; XOR/AND — круг.&#10;Эллипс — исполнитель; прямоугольник с боковыми полосами — программа; документ — информационный объект. Сплошные стрелки — поток процесса; пунктир — дополнительные связи. Повторяющиеся ресурсы обозначают один и тот же объект." style="text;html=1;whiteSpace=wrap;align=left;fontSize=15;fontFamily=Arial;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="3518.0" width="1600" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="epc_AS_IS_A4" name="A4 — Оценить результаты рекламной кампании"><mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="epc_AS_IS_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd" label="Период кампании завершён; данные&#10;мониторинга подготовлены" epc-kind="event" source-id="8ab7e795-d9ea-4638-a4b6-c471bae29dcd" original-label="Период кампании завершён; данные мониторинга подготовлены" description=""><mxCell style="shape=hexagon;size=.10;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680.0" y="106.0" width="240" height="60" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A4_da36d4c0_9337_4c02_a876_4390df343695" label="XOR" epc-kind="rule" source-id="da36d4c0-9337-4c02-a876-4390df343695" original-label="XOR" description=""><mxCell style="ellipse;aspect=fixed;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="783.0" y="223.0" width="34" height="34" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" label="Собрать результаты рекламной&#10;кампании" epc-kind="function" source-id="c8dd9c61-5cfa-4cdf-a1ee-ba05bb5b2765" original-label="Собрать результаты рекламной кампании" description="Функция A41. Входы: Данные мониторинга; Данные цифровых каналов; Данные розничных размещений; Данные о продажах. Результаты: Сводные результаты кампании. Обеспечение (атомарно): Менеджер рекламной кампании; Специалист digital-коммуникаций; Trade-маркетолог; Маркетинговый аналитик; Категорийный менеджер; Персональный компьютер; Excel; Почтовый клиент; Корпоративная почта; Рекламный кабинет; Сервис веб-аналитики. Управление: Методика оценки результатов кампании; Требования к отчётности."><mxCell style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#D5E8D4;strokeColor=#609E60;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="680.0" y="414.0" width="240" height="66" as="geometry"/></mxCell></UserObject><UserObject id="epc_AS_IS_A4_fdec0b2a_1b2c_4364_813b_ef1b22f7cfbc_at_1" label="Excel" epc-kind="application" source-id="fdec0b2a-1b2c-4364-813b-ef1b22f7cfbc" original-label="Excel" description=""><mxCell style="shape=process;size=.06;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="405.0" y="314.0" width="230" height="30" as="geometry"/></mxCell></UserObject><mxCell id="epc_AS_IS_A4_edge_11" style="html=1;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;dashPattern=3 3;endArrow=none;endFill=0;endSize=6;rounded=0;curved=0;exitX=1;exitY=0.5;entryX=0;entryY=0.125;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="epc_AS_IS_A4_fdec0b2a_1b2c_4364_813b_ef1b22f7cfbc_at_1" target="epc_AS_IS_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765"><mxGeometry relative="1" as="geometry"/></mxCell><UserObject id="epc_AS_IS_A4_673dc3a4_1734_4d13_924f_75a36497d1a4_at_2" label="Корпоративная почта" epc-kind="application" source-id="673dc3a4-1734-4d13-924f-75a36497d1a4" original-label="Корпоративная почта" description=""><mxCell style="shape=process;size=.0