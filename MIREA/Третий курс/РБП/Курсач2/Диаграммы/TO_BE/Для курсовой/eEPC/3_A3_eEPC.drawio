t="36" as="geometry"/></mxCell></UserObject><mxCell id="a3_edge_35" source="A32_role1_at_7" target="A32" edge="1" parent="1" style="html=1;strokeColor=#936900;strokeWidth=1;dashed=1;dashPattern=3 3;endArrow=none;endFill=0;endSize=6;rounded=0;curved=0;exitX=0;exitY=0.5;entryX=1;entryY=0.3333333333333333;exitPerimeter=1;entryPerimeter=1;"><mxGeometry relative="1" as="geometry"/></mxCell><UserObject id="A32_role0_at_8" label="Специалист&#10;digital-коммуникаций" epc-kind="role" original-label="Специалист digital-коммуникаций" source-id="A32_role0" description=""><mxCell vertex="1" parent="1" style="ellipse;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.2;"><mxGeometry x="985.0" y="442.0" width="260" height="52" as="geometry"/></mxCell></UserObject><mxCell id="a3_edge_33" source="A32_role0_at_8" target="A32" edge="1" parent="1" style="html=1;strokeColor=#936900;strokeWidth=1;dashed=1;dashPattern=3 3;endArrow=none;endFill=0;endSize=6;rounded=0;curved=0;exitX=0;exitY=0.5;entryX=1;entryY=0.6666666666666666;exitPerimeter=1;entryPerimeter=1;"><mxGeometry relative="1" as="geometry"/></mxCell><UserObject id="Launched" label="Запуск цифрового и розничного&#10;направлений подтверждён" epc-kind="event" original-label="Запуск цифрового и розничного направлений подтверждён" source-id="Launched" description=""><mxCell vertex="1" parent="1" style="shape=hexagon;size=.10;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.2;"><mxGeometry x="660.0" y="522.0" width="280" height="66" as="geometry"/></mxCell></UserObject><UserObject id="Join" label="XOR" epc-kind="rule" original-label="XOR" source-id="Join" description=""><mxCell vertex="1" parent="1" style="ellipse;aspect=fixed;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;"><mxGeometry x="778.0" y="608.0" width="44" height="44" as="geometry"/></mxCell></UserObject><UserObject id="A33" label="Контролировать и корректировать&#10;кампанию в BPMSoft" epc-kind="function" original-label="Контролировать и корректировать кампанию в BPMSoft" source-id="A33" description="Показатели рекламного кабинета и веб-аналитики проверяются и импортируются в BPMSoft. Система формирует сводку и контрольные задачи; менеджер анализирует отклонения. Исправления выполняются в каналах и фиксируются в карточке; изменение условий возвращается на согласование."><mxCell vertex="1" parent="1" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#CFE2F3;strokeColor=#5685A7;strokeWidth=1.2;"><mxGeometry x="660.0" y="708.0" width="280" height="76" as="geometry"/></mxCell></UserObject><UserObject id="A33_application0_at_9" label="BPMSoft" epc-kind="application" original-label="BPMSoft" source-id="A33_application0" description=""><mxCell vertex="1" parent="1" style="shape=process;size=.06;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.2;"><mxGeometry x="355.0" y="680.0" width="260" height="36" as="geometry"/></mxCell></UserObject><mxCell id="a3_edge_47" source="A33_application0_at_9" target="A33" edge="1" parent="1" style="html=1;strokeColor=#6C8EBF;strokeWidth=1;dashed=1;dashPattern=3 3;endArrow=none;endFill=0;endSize=6;rounded=0;curved=0;exitX=1;exitY=0.5;entryX=0;entryY=0.25;exitPerimeter=1;entryPerimeter=1;"><mxGeometry relative="1" as="geometry"/></mxCell><UserObject id="A33_application1_at_10" label="Рекламный кабинет" epc-kind="application" original-label="Рекламный кабинет" source-id="A33_application1" description=""><mxCell vertex="1" parent="1" style="shape=process;size=.06;html=1;whiteSpace=