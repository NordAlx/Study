<mxfile host="app.diagrams.net"><diagram id="TOBE_A3_Print" name="A3"><mxGraphModel page="0" grid="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject id="Start" label="Медиаплан и рекламные материалы&#10;согласованы" epc-kind="event" original-label="Медиаплан и рекламные материалы согласованы" source-id="Start" description=""><mxCell vertex="1" parent="1" style="shape=hexagon;size=.10;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.2;"><mxGeometry x="660.0" y="102.0" width="280" height="66" as="geometry"/></mxCell></UserObject><UserObject id="A31" label="Подготовить каналы и проверить&#10;готовность в BPMSoft" epc-kind="function" original-label="Подготовить каналы и проверить готовность в BPMSoft" source-id="A31" description="Digital-специалист готовит сегмент и email в BPMSoft, цифровые размещения — в рекламном кабинете. Trade-маркетолог передаёт инструкции из карточки через подключённую почту. Ответы магазинов сохраняются в истории кампании; сотрудник проверяет готовность."><mxCell vertex="1" parent="1" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=5;fillColor=#CFE2F3;strokeColor=#5685A7;strokeWidth=1.2;"><mxGeometry x="660.0" y="202.0" width="280" height="76" as="geometry"/></mxCell></UserObject><UserObject id="A31_application0_at_1" label="BPMSoft" epc-kind="application" original-label="BPMSoft" source-id="A31_application0" description=""><mxCell vertex="1" parent="1" style="shape=process;size=.06;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=5;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.2;"><mxGeometry x="355.0" y="196.0" width="260" height="36" as="geometry"/></mxCell></UserObject><mxCell id="a3_edge_29" source="A31_application0_at_1" target="A31" edge="1" parent=