<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Print_Defs_A4" targetNamespace="urn:gloria:to-be:print"><bpmn:process id="Print_Process_A4" isExecutable="false"><bpmn:documentation>Печатное представление той же функциональной модели: четырнадцать основных операций, единый контур BPMSoft, те же исходы и исполнители. Входы и результаты подробно показаны в IDEF0. Содержательные решения принимают сотрудники.</bpmn:documentation><bpmn:laneSet id="LaneSet_A4"><bpmn:lane id="Lane_A4_0" name="Маркетинговый аналитик"><bpmn:flowNodeRef>epc_TO_BE_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_d75aa29e_2319_44f4_a4e3_ce4fa3038a0b</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_A4_1" name="Менеджер рекламной кампании"><bpmn:flowNodeRef>A4_ReportDraft_Print</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_fb8cc365_a086_41e1_855b_d427030dfc6a</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A4_1090dfea_fcc2_4864_a435_bfb26dbaf7b6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="epc_TO_BE_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd" name="Период кампании завершён; данные мониторинга подготовлены"><bpmn:outgoing>bpmn_flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695" name=""><bpmn:incoming>bpmn_flow_0</bpmn:incoming><bpmn:incoming>bpmn_flow_5</bpmn:incoming><bpmn:outgoing>bpmn_flow_3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" name="Проверить результаты и сформировать сводку в BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_3</bpmn:incoming><bpmn:outgoing>bpmn_flow_2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8" name=""><bpmn:incoming>bpmn_flow_2</bpmn:incoming><bpmn:outgoing>bpmn_flow_4</bpmn:outgoing><bpmn:outgoing>bpmn_flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="epc_TO_BE_A4_d75aa29e_2319_44f4_a4e3_ce4fa3038a0b" name="Проверить показатели и оценить эффективность в BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_4</bpmn:incoming><bpmn:outgoing>bpmn_flow_6</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="A4_ReportDraft_Print" name="Сформировать проект отчёта в BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_6</bpmn:incoming><bpmn:outgoing>bpmn_flow_7</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="epc_TO_BE_A4_fb8cc365_a086_41e1_855b_d427030dfc6a" name="Проверить и передать итоговый отчёт из BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_7</bpmn:incoming><bpmn:outgoing>bpmn_flow_1</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="epc_TO_BE_A4_1090dfea_fcc2_4864_a435_bfb26dbaf7b6" name="Итоговый отчёт сформирован и передан директору маркетинга и категорийному менеджеру"><bpmn:incoming>bpmn_flow_1</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="bpmn_flow_0" sourceRef="epc_TO_BE_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd" targetRef="epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695"/><bpmn:sequenceFlow id="bpmn_flow_1" sourceRef="epc_TO_BE_A4_fb8cc365_a086_41e1_855b_d427030dfc6a" targetRef="epc_TO_BE_A4_1090dfea_fcc2_4864_a435_bfb26dbaf7b6"/><bpmn:sequenceFlow id="bpmn_flow_2" sourceRef="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" targetRef="epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8"/><bpmn:sequenceFlow id="bpmn_flow_3" sourceRef="epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695" targetRef="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765"/><bpmn:sequenceFlow id="bpmn_flow_4" sourceRef="epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8" targetRef="epc_TO_BE_A4_d75aa29e_2319_44f4_a4e3_ce4fa3038a0b" name="Данные проверены"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'Данные проверены'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="bpmn_flow_6" sourceRef="epc_TO_BE_A4_d75aa29e_2319_44f4_a4e3_ce4fa3038a0b" targetRef="A4_ReportDraft_Print"/><bpmn:sequenceFlow id="bpmn_flow_7" sourceRef="A4_ReportDraft_Print" targetRef="epc_TO_BE_A4_fb8cc365_a086_41e1_855b_d427030dfc6a"/><bpmn:sequenceFlow id="bpmn_flow_5" sourceRef="epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8" targetRef="epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695" name="Нужно уточнение"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'Нужно уточнение'</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:process><bpmn:collaboration id="Collab_A4"><bpmn:participant id="Participant_Print_A4" name="Департамент маркетинга и рекламы" processRef="Print_Process_A4"/><bpmn:participant id="Participant_Adjacent_A4" name="Коммерческий блок — Категорийный менеджер"/><bpmn:messageFlow id="Message_A4_0" sourceRef="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" targetRef="Participant_Adjacent_A4" name="Запрос данных"/><bpmn:messageFlow id="Message_A4_0_Reply" sourceRef="Participant_Adjacent_A4" targetRef="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" name="Исходные коммерческие данные"/><bpmn:messageFlow id="Message_A4_1" sourceRef="epc_TO_BE_A4_fb8cc365_a086_41e1_855b_d427030dfc6a" targetRef="Participant_Adjacent_A4" name="Итоговый отчёт"/></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram_Print_A4"><bpmndi:BPMNPlane id="Plane_Print_A4" bpmnElement="Collab_A4"><bpmndi:BPMNShape id="DI_Participant_Print_A4" bpmnElement="Participant_Print_A4" isHorizontal="true"><dc:Bounds x="445.0" y="-8.0" width="768.0" height="1037.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_A4_0" bpmnElement="Lane_A4_0" isHorizontal="true"><dc:Bounds x="477.0" y="-8.0" width="736.0" height="568.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_A4_1" bpmnElement="Lane_A4_1" isHorizontal="true"><dc:Bounds x="477.0" y="560.0" width="736.0" height="469.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_epc_TO_BE_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd" bpmnElement="epc_TO_BE_A4_8ab7e795_d9ea_4638_a4b6_c471bae29dcd"><dc:Bounds x="768.0" y="102.0" width="64.0" height="64.0"/><bpmndi:BPMNLabel><dc:Bounds x="675.0" y="17.0" width="250" height="57"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695" bpmnElement="epc_TO_BE_A4_da36d4c0_9337_4c02_a876_4390df343695"><dc:Bounds x="774.0" y="186.0" width="52.0" height="52.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765" bpmnElement="epc_TO_BE_A4_c8dd9c61_5cfa_4cdf_a1ee_ba05bb5b2765"><dc:Bounds x="660.0" y="258.0" width="280.0" height="100.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8" bpmnElement="epc_TO_BE_A4_708c4d04_1538_422f_bc39_875a42d2c2c8"><dc:Bounds x="774.0" y="378.0" width="52.0" height="52.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_epc_TO_BE_A4_d75aa29e_2319_44f4_a4e3_ce4fa3038