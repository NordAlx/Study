<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Print_Defs_A1" targetNamespace="urn:gloria:to-be:print"><bpmn:process id="Print_Process_A1" isExecutable="false"><bpmn:documentation>Печатное представление той же функциональной модели: четырнадцать основных операций, единый контур BPMSoft, те же исходы и исполнители. Входы и результаты подробно показаны в IDEF0. Содержательные решения принимают сотрудники.</bpmn:documentation><bpmn:laneSet id="LaneSet_A1"><bpmn:lane id="Lane_A1_0" name="Директор департамента маркетинга и рекламы"><bpmn:flowNodeRef>epc_TO_BE_A1_2d468efb_55a0_4814_8439_a8a9abde1131</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_3803aff1_3743_4138_8948_c2c08bd3bcf8</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_b13371a6_be7a_4390_93d6_10668049d6e2</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_2729ca0a_1ab7_4ead_b65c_e6bda592417f</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_92ced5f7_a19c_4160_bdfa_9552c4e80e5c</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_A1_1" name="Менеджер рекламной кампании"><bpmn:flowNodeRef>epc_TO_BE_A1_67378ba4_832e_4e27_b65f_fbd3f0db366b</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_8564dae7_027f_4089_bbb1_9678a12621b7</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_4694c0dd_fa48_411d_998e_09b21235a39d</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_988207cd_d6e5_4ac8_95c9_ea75485eb074</bpmn:flowNodeRef><bpmn:flowNodeRef>epc_TO_BE_A1_c68702c2_b954_4d85_943a_ee9d8ee7f211</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="epc_TO_BE_A1_2d468efb_55a0_4814_8439_a8a9abde1131" name="Возникла потребность в проведении рекламной кампании"><bpmn:outgoing>bpmn_flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="epc_TO_BE_A1_3803aff1_3743_4138_8948_c2c08bd3bcf8" name="Определить потребность в рекламной кампании"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_0</bpmn:incoming><bpmn:outgoing>bpmn_flow_2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="epc_TO_BE_A1_b13371a6_be7a_4390_93d6_10668049d6e2" name=""><bpmn:incoming>bpmn_flow_2</bpmn:incoming><bpmn:outgoing>bpmn_flow_5</bpmn:outgoing><bpmn:outgoing>bpmn_flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="epc_TO_BE_A1_2729ca0a_1ab7_4ead_b65c_e6bda592417f" name="Оформлено решение об отказе от проведения кампании"><bpmn:incoming>bpmn_flow_5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="epc_TO_BE_A1_92ced5f7_a19c_4160_bdfa_9552c4e80e5c" name="Создать карточку и назначить задачи в BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_6</bpmn:incoming><bpmn:outgoing>bpmn_flow_7</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="epc_TO_BE_A1_67378ba4_832e_4e27_b65f_fbd3f0db366b" name=""><bpmn:incoming>bpmn_flow_7</bpmn:incoming><bpmn:incoming>bpmn_flow_9</bpmn:incoming><bpmn:outgoing>bpmn_flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="epc_TO_BE_A1_8564dae7_027f_4089_bbb1_9678a12621b7" name="Проверить и дополнить исходные данные в BPMSoft"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_4</bpmn:incoming><bpmn:outgoing>bpmn_flow_3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="epc_TO_BE_A1_4694c0dd_fa48_411d_998e_09b21235a39d" name=""><bpmn:incoming>bpmn_flow_3</bpmn:incoming><bpmn:outgoing>bpmn_flow_8</bpmn:outgoing><bpmn:outgoing>bpmn_flow_9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="epc_TO_BE_A1_988207cd_d6e5_4ac8_95c9_ea75485eb074" name="Сформировать и проверить электронный бриф"><bpmn:documentation>Карточка, данные, версии и история коммуникаций ведутся в BPMSoft. Система назначает задачи и формирует представления; сотрудник проверяет содержание.</bpmn:documentation><bpmn:incoming>bpmn_flow_8</bpmn:incoming><bpmn:outgoing>bpmn_flow_1</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="epc_TO_BE_A1_c68702c2_b954_4d85_943a_ee9d8ee7f211" name="Бриф рекламной кампании сформирован"><bpmn:incoming>bpmn_flow_1</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="bpmn_flow_0" sourceRef="epc_TO_BE_A1_2d468efb_55a0_4814_8439_a8a9abde1131" targetRef="epc_TO_BE_A1_3803aff1_3743_4138_8948_c2c08bd3bcf8"/><bpmn:sequenceFlow id="bpmn_flow_1" sourceRef="epc_TO_BE_A1_988207cd_d6e5_4ac8_95c9_ea75485eb074" targetRef="epc_TO_BE_A1_c68702c2_b954_4d85_943a_ee9d8ee7f211" name="Бриф готов"/><bpmn:sequenceFlow id="bpmn_flow_2" sourceRef="epc_TO_BE_A1_3803aff1_3743_4138_8948_c2c08bd3bcf8" targetRef="epc_TO_BE_A1_b13371a6_be7a_4390_93d6_10668049d6e2"/><bpmn:sequenceFlow id="bpmn_flow_3" sourceRef="epc_TO_BE_A1_8564dae7_027f_4089_bbb1_9678a12621b7" targetRef="epc_TO_BE_A1_4694c0dd_fa48_411d_998e_09b21235a39d"/><bpmn:sequenceFlow id="bpmn_flow_4" sourceRef="epc_TO_BE_A1_67378ba4_832e_4e27_b65f_fbd3f0db366b" targetRef="epc_TO_BE_A1_8564dae7_027f_4089_bbb1_9678a12621b7"/><bpmn:sequenceFlow id="bpmn_flow_5" sourceRef="epc_TO_BE_A1_b13371a6_be7a_4390_93d6_10668049d6e2" targetRef="epc_TO_BE_A1_2729ca0a_1ab7_4ead_b65c_e6bda592417f" name="Отказ"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'Отказ'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="bpmn_flow_7" sourceRef="epc_TO_BE_A1_92ced5f7_a19c_4160_bdfa_9552c4e80e5c" targetRef="epc_TO_BE_A1_67378ba4_832e_4e27_b65f_fbd3f0db366b" name="Задача на проведение кампании сформирована"/><bpmn:sequenceFlow id="bpm