      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A2_M24" name="" gatewayDirection="Converging">
      <bpmn:incoming>A2_F9</bpmn:incoming>
      <bpmn:incoming>A2_F10</bpmn:incoming>
      <bpmn:outgoing>A2_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A2_Submit" name="Передать версии на электронное согласование">
      <bpmn:documentation>Функция A24. Директор получает пользовательскую задачу на конкретные версии плана и материалов. Решение и замечания сохраняются; доработка назначается менеджеру и/или разработчику. Изменённые версии подлежат повторному согласованию.
Механизмы: Директор департамента маркетинга и рекламы; Менеджер рекламной кампании; Персональный компьютер; BPMSoft.
Входы: Медиаплан; Рекламные материалы.
Результаты: Согласованный электронный медиаплан; Согласованные рекламные материалы; Решение о согласовании версий; Замечания к версиям медиаплана и материалов.
Управление: Электронный бриф рекламной кампании; Утверждённый бюджетный лимит; Утверждённые коммерческие условия акции; Брендбук; Регламент работы и согласования в BPMSoft; Требования к рекламе; Требования к информации о товарах; Требования к обработке персональных данных.</bpmn:documentation>
      <bpmn:incoming>A2_F11</bpmn:incoming>
      <bpmn:outgoing>A2_F12</bpmn:outgoing>
      <bpmn:ioSpecification id="A2_Submit_IO">
        <bpmn:dataInput id="A2_Data_10_Item" name="Медиаплан [до согласования] (BPMSoft)"/>
        <bpmn:dataInput id="A2_Data_13_Item" name="Рекламные материалы [до согласования]"/>
        <bpmn:dataInput id="A2_Data_29_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_30_Item" name="История коммуникаций в BPMSoft"/>
        <bpmn:inputSet id="A2_Submit_InputSet">
          <bpmn:dataInputRefs>A2_Data_10_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_13_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_29_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A2_Submit_OutputSet">
          <bpmn:dataOutputRefs>A2_Data_30_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A2_Data_10">
        <bpmn:sourceRef>A2_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_10_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_13">
        <bpmn:sourceRef>A2_Doc4</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_13_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_29">
        <bpmn:sourceRef>A2_Store10</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_29_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A2_Data_30">
        <bpmn:sourceRef>A2_Data_30_Item</bpmn:sourceRef>
        <bpmn:targetRef>A2_Store11</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A2_Submit_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
