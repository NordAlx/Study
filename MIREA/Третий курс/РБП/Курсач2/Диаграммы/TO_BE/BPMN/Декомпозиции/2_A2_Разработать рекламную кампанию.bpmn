<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A2" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Контакты и согласия в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_MailingLog" name="История рассылок в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Карточки, версии документов и результаты в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CorporateMail" name="История коммуникаций в BPMSoft" isUnlimited="true"/>
  <bpmn:process id="Process_A2" name="Разработать рекламную кампанию" isExecutable="false">
    <bpmn:documentation>Учебная модель TO BE: единый рабочий контур BPMSoft. Настроенные поля, шаблоны, маршруты, подключённая почта, рассылки и аналитика. Автоматическое получение внешних рекламных показателей не предполагается; выгрузки проверяет сотрудник. Пользовательские задачи сохраняют человеческие решения; автоматическое формирование проекта отчёта выделено отдельно. isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="A2_LaneSet">
      <bpmn:lane id="A2_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A2_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_M22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_M24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A2_Lane_R3" name="Специалист по разработке рекламных материалов">
        <bpmn:flowNodeRef>A2_M23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A23</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A2_Lane_R1" name="Директор департамента маркетинга и рекламы">
        <bpmn:flowNodeRef>A2_A24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G25</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A2_Start" name="Получен бриф или запрос изменений">
      <bpmn:outgoing>A2_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A2_G20" name="Первичная разработка?" gatewayDirection="Diverging">
      <bpmn:incoming>A2_F1</bpmn:incoming>
      <bpmn:outgoing>A2_F2</bpmn:outgoing>
      <bpmn:outgoing>A2_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A2_A21" name="Разработать концепцию в карточке BPMSoft">
      <bpmn:documentation>Функция A21. Менеджер разрабатывает концепцию и вводит описание в карточке кампании BPMSoft. Содержательные решения принимает сотрудник.
Механизмы: Менеджер рекламной кампании; Персональный компьютер; BPMSoft.
Входы: Электронный бриф рекламной кампании; Сводные исходные данные в карточке кампании.
Результаты: Концепция рекламной кампании в карточке.
Управление: Брендбук; Маркетинговая стратегия; Требования к рекламе; Требования к информации о товарах.</bpmn:documentation>
      <bpmn:incoming>A2_F2</bpmn:incoming>
      <bpmn:outgoing>A2_F4</bpmn:outgoing>
      <bpmn:ioSpecification id="A2_A21_IO">
        <bpmn:dataInput id="A2_Data_1_Item" name="Бриф [вход из A1]"/>
        <bpmn:dataInput id="A2_Data_23_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_5_Item" name="Концепция рекламной кампании (BPMSoft)"/>
        <bpmn:dataOutput id="A2_Data_24_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:inputSet id="A2_A21_InputSet">
          <bpmn:dataInputRefs>A2_Data_1_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_23_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A2_A21_OutputSet">
          <bpmn:dataOutputRefs>A2_Data_5_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A2_Data_24_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A2_Data_1">
        <bpmn:sourceRef>A2_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_1_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_23">
        <bpmn:sourceRef>A2_Store10</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_23_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A2_Data_5">
        <bpmn:sourceRef>A2_Data_5_Item</bpmn:sourceRef>
        <bpmn:targetRef>A2_Doc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A2_Data_24">
        <bpmn:sourceRef>A2_Data_24_Item</bpmn:sourceRef>
        <bpmn:targetRef>A2_Store10</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A2_A21_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A2_M22" name="" gatewayDirection="Converging">
      <bpmn:incoming>A2_F3</bpmn:incoming>
      <bpmn:incoming>A2_F4</bpmn:incoming>
      <bpmn:incoming>A2_F16</bpmn:incoming>
      <bpmn:incoming>A2_F17</bpmn:incoming>
      <bpmn:outgoing>A2_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A2_A22" name="Сформировать медиаплан">
      <bpmn:documentation>Функция A22. Менеджер заполняет строки медиаплана: каналы, форматы, сроки, бюджет и плановые показатели. Для согласования фиксируется версия плана.
Механизмы: Менеджер рекламной кампании; Персональный компьютер; BPMSoft.
Входы: Электронный бриф рекламной кампании; Концепция рекламной кампании в карточке.
Результаты: Медиаплан.
Управление: Утверждённый бюджетный лимит; Утверждённые коммерческие условия акции; Технические требования каналов размещения; Шаблоны полей и документов кампании; Замечания к версиям медиаплана и материалов; Данные мониторинга в карточке кампании.</bpmn:documentation>
      <bpmn:incoming>A2_F5</bpmn:incoming>
      <bpmn:outgoing>A2_F6</bpmn:outgoing>
      <bpmn:ioSpecification id="A2_A22_IO">
        <bpmn:dataInput id="A2_Data_2_Item" name="Бриф [вход из A1]"/>
        <bpmn:dataInput id="A2_Data_6_Item" name="Концепция рекламной кампании (BPMSoft)"/>
        <bpmn:dataInput id="A2_Data_16_Item" name="Замечания к версиям медиаплана и материалов"/>
        <bpmn:dataInput id="A2_Data_21_Item" name="Данные мониторинга [повторный вход из A3]"/>
        <bpmn:dataInput id="A2_Data_25_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_8_Item" name="Медиаплан [до согласования] (BPMSoft)"/>
        <bpmn:dataOutput id="A2_Data_26_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:inputSet id="A2_A22_InputSet">
          <bpmn:dataInputRefs>A2_Data_2_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_6_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_16_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_21_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_25_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A2_A22_OutputSet">
          <bpmn:dataOutputRefs>A2_Data_8_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A2_Data_26_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A2_Data_2">
        <bpmn:sourceRef>A2_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_2_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_6">
        <bpmn:sourceRef>A2_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_6_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_16">
        <bpmn:sourceRef>A2_Doc5</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_16_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_21">
        <bpmn:sourceRef>A2_Doc9</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_21_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_25">
        <bpmn:sourceRef>A2_Store10</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_25_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A2_Data_8">
        <bpmn:sourceRef>A2_Data_8_Item</bpmn:sourceRef>
        <bpmn:targetRef>A2_Doc3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A2_Data_26">
        <bpmn:sourceRef>A2_Data_26_Item</bpmn:sourceRef>
        <bpmn:targetRef>A2_Store10</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A2_A22_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A2_G22" name="Нужны новые или изменённые материалы?" gatewayDirection="Diverging">
      <bpmn:incoming>A2_F6</bpmn:incoming>
      <bpmn:outgoing>A2_F7</bpmn:outgoing>
      <bpmn:outgoing>A2_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="A2_M23" name="" gatewayDirection="Converging">
      <bpmn:incoming>A2_F7</bpmn:incoming>
      <bpmn:incoming>A2_F18</bpmn:incoming>
      <bpmn:outgoing>A2_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A2_A23" name="Подготовить тексты и загрузить макеты в BPMSoft">
      <bpmn:documentation>Функция A23. Специалист готовит тексты и шаблоны коммуникаций в BPMSoft. Графические макеты создаёт в графическом редакторе и загружает версии в карточку. Отдельный текстовый редактор не используется.
Механизмы: Специалист по разработке рекламных материалов; Персональный компьютер; Графический редактор; BPMSoft.
Входы: Электронный бриф рекламной кампании; Концепция рекламной кампании в карточке; Медиаплан.
Результаты: Рекламные материалы.
Управление: Брендбук; Технические требования каналов размещения; Требования к рекламе; Требования к информации о товарах; Замечания к версиям медиаплана и материалов; Данные мониторинга в карточке кампании.</bpmn:documentation>
      <bpmn:incoming>A2_F8</bpmn:incoming>
      <bpmn:outgoing>A2_F9</bpmn:outgoing>
      <bpmn:ioSpecification id="A2_A23_IO">
        <bpmn:dataInput id="A2_Data_3_Item" name="Бриф [вход из A1]"/>
        <bpmn:dataInput id="A2_Data_7_Item" name="Концепция рекламной кампании (BPMSoft)"/>
        <bpmn:dataInput id="A2_Data_9_Item" name="Медиаплан [до согласования] (BPMSoft)"/>
        <bpmn:dataInput id="A2_Data_17_Item" name="Замечания к версиям медиаплана и материалов"/>
        <bpmn:dataInput id="A2_Data_22_Item" name="Данные мониторинга [повторный вход из A3]"/>
        <bpmn:dataInput id="A2_Data_27_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_12_Item" name="Рекламные материалы [до согласования]"/>
        <bpmn:dataOutput id="A2_Data_28_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:inputSet id="A2_A23_InputSet">
          <bpmn:dataInputRefs>A2_Data_3_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_7_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_9_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_17_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_22_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A2_Data_27_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A2_A23_OutputSet">
          <bpmn:dataOutputRefs>A2_Data_12_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A2_Data_28_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A2_Data_3">
        <bpmn:sourceRef>A2_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_3_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_7">
        <bpmn:sourceRef>A2_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_7_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_9">
        <bpmn:sourceRef>A2_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_9_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_17">
        <bpmn:sourceRef>A2_Doc5</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_17_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_22">
        <bpmn:sourceRef>A2_Doc9</bpmn:sourceRef>
        <bpmn:targetRef>A2_Data_22_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A2_Data_27">
