        <bpmn:dataInput id="A3_Data_5_Item" name="Список адресатов рассылки"/>
        <bpmn:dataInput id="A3_Data_7_Item" name="Подготовленные email-сообщения"/>
        <bpmn:dataInput id="A3_Data_9_Item" name="Параметры цифровых размещений"/>
        <bpmn:dataInput id="A3_Data_25_Item" name="Журнал email-рассылок (BPMSoft)"/>
        <bpmn:dataOutput id="A3_Data_14_Item" name="Подтверждения запуска и размещения"/>
        <bpmn:dataOutput id="A3_Data_26_Item" name="Журнал email-рассылок (BPMSoft)"/>
