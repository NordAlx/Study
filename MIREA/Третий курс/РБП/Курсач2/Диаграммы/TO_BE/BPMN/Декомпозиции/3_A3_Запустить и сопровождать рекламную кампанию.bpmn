      <bpmn:outgoing>A3_F9</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="A3_LaunchDate" name="Дата запуска / применения изменений из медиаплана">
      <bpmn:documentation>Ожидание согласованной календарной даты; при уже наступившем сроке дополнительное ожидание не требуется. Для повторного входа используется дата применения согласованных изменений.</bpmn:documentation>
      <bpmn:incoming>A3_F9</bpmn:incoming>
      <bpmn:outgoing>A3_F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="A3_LaunchDate_Timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">CampaignLaunchOrChangeDate</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="A3_P32" name="" gatewayDirection="Diverging">
      <bpmn:incoming>A3_F10</bpmn:incoming>
      <bpmn:outgoing>A3_F11</bpmn:outgoing>
      <bpmn:outgoing>A3_F12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="A3_T32d" name="Запустить цифровые размещения и утверждённую рассылку">
      <bpmn:documentation>Функция A32. Digital-специалист запускает утверждённую рассылку в BPMSoft и размещения в рекламном кабинете. Trade-маркетолог проверяет подтверждения магазинов в карточке. Почтовый клиент и отдельный журнал отправок не используются.
Механизмы: Специалист digital-коммуникаций; Trade-маркетолог; Руководитель магазина; Персональный компьютер; BPMSoft; Рекламный кабинет.
Входы: Параметры цифровых размещений; Подготовленные email-сообщения; Список адресатов рассылки; Согласованные рекламные материалы.
Результаты: Подтверждения запуска и размещения.
Управление: Согласованный электронный медиаплан; Регламент работы и согласования в BPMSoft; Требования к рекламе; Требования к обработке персональных данных; Требования к информации о товарах; Решение о согласовании версий; Данные мониторинга в карточке кампании; Инструкции для магазинов; Подтверждения готовности каналов.</bpmn:documentation>
      <bpmn:incoming>A3_F11</bpmn:incoming>
      <bpmn:outgoing>A3_F17</bpmn:outgoing>
      <bpmn:ioSpecification id="A3_T32d_IO">
