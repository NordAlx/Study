        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A3_Data_3">
        <bpmn:sourceRef>A3_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A3_Data_3_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
