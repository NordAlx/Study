    <bpmn:exclusiveGateway id="A3_G31r" name="Готовность магазинов подтверждена?" gatewayDirection="Diverging">
      <bpmn:incoming>A3_F5</bpmn:incoming>
      <bpmn:outgoing>A3_F6</bpmn:outgoing>
      <bpmn:outgoing>A3_F7</bpmn:outgoing>
