<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A3" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Контакты и согласия в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_MailingLog" name="История рассылок в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Карточки, версии документов и результаты в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CorporateMail" name="История коммуникаций в BPMSoft" isUnlimited="true"/>
  <bpmn:process id="Process_A3" name="Запустить и сопровождать рекламную кампанию" isExecutable="false">
    <bpmn:documentation>Учебная модель TO BE: единый рабочий контур BPMSoft. Настроенные поля, шаблоны, маршруты, подключённая почта, рассылки и аналитика. Автоматическое получение внешних рекламных показателей не предполагается; выгрузки проверяет сотрудник. Пользовательские задачи сохраняют человеческие решения; автоматическое формирование проекта отчёта выделено отдельно. isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="A3_LaneSet">
      <bpmn:lane id="A3_Lane_R4" name="Специалист digital-коммуникаций">
        <bpmn:flowNodeRef>A3_T31d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T32d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33dataD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33d</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A3_Lane_R5" name="Trade-маркетолог">
        <bpmn:flowNodeRef>A3_M31r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T31r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G31r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_M32r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T32r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G32r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33dataR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A3_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A3_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_P31</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_J31</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_LaunchDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_P32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_J32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_M33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_P33data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_J33data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G33a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G33b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_Reapprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G33c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_CheckDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_P33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_J33</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A3_Start" name="Медиаплан и рекламные материалы согласованы">
      <bpmn:outgoing>A3_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="A3_P31" name="" gatewayDirection="Diverging">
      <bpmn:incoming>A3_F1</bpmn:incoming>
      <bpmn:outgoing>A3_F2</bpmn:outgoing>
      <bpmn:outgoing>A3_F3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="A3_T31d" name="Подготовить сегмент и email в BPMSoft; цифровые параметры в кабинете">
      <bpmn:documentation>Функция A31. Digital-специалист готовит сегмент и email в BPMSoft, цифровые размещения — в рекламном кабинете. Trade-маркетолог передаёт инструкции из карточки через подключённую почту. Ответы магазинов сохраняются в истории кампании; сотрудник проверяет готовность.
Механизмы: Специалист digital-коммуникаций; Trade-маркетолог; Руководитель магазина; Персональный компьютер; BPMSoft; Рекламный кабинет.
Входы: Согласованные рекламные материалы; Список клиентских контактов; Подтверждения готовности магазинов.
Результаты: Параметры цифровых размещений; Подготовленные email-сообщения; Список адресатов рассылки; Инструкции для магазинов; Подтверждения готовности каналов; Рекламные материалы, переданные магазинам.
Управление: Согласованный электронный медиаплан; Технические требования каналов размещения; Требования к рекламе; Требования к обработке персональных данных; Требования к информации о товарах; Решение о согласовании версий; Данные мониторинга в карточке кампании.</bpmn:documentation>
      <bpmn:incoming>A3_F2</bpmn:incoming>
      <bpmn:outgoing>A3_F8</bpmn:outgoing>
      <bpmn:ioSpecification id="A3_T31d_IO">
        <bpmn:dataInput id="A3_Data_1_Item" name="Согласованные материалы [вход из A2]"/>
        <bpmn:dataInput id="A3_Data_24_Item" name="Контакты и согласия (BPMSoft)"/>
        <bpmn:dataInput id="A3_Data_30_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A3_Data_4_Item" name="Список адресатов рассылки"/>
        <bpmn:dataOutput id="A3_Data_6_Item" name="Подготовленные email-сообщения"/>
        <bpmn:dataOutput id="A3_Data_8_Item" name="Параметры цифровых размещений"/>
        <bpmn:inputSet id="A3_T31d_InputSet">
          <bpmn:dataInputRefs>A3_Data_1_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A3_Data_24_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A3_Data_30_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A3_T31d_OutputSet">
          <bpmn:dataOutputRefs>A3_Data_4_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A3_Data_6_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A3_Data_8_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A3_Data_1">
        <bpmn:sourceRef>A3_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A3_Data_1_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A3_Data_24">
        <bpmn:sourceRef>A3_Store11</bpmn:sourceRef>
        <bpmn:targetRef>A3_Data_24_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A3_Data_30">
        <bpmn:sourceRef>A3_Store13</bpmn:sourceRef>
        <bpmn:targetRef>A3_Data_30_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A3_Data_4">
        <bpmn:sourceRef>A3_Data_4_Item</bpmn:sourceRef>
        <bpmn:targetRef>A3_Doc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A3_Data_6">
        <bpmn:sourceRef>A3_Data_6_Item</bpmn:sourceRef>
        <bpmn:targetRef>A3_Doc3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A3_Data_8">
        <bpmn:sourceRef>A3_Data_8_Item</bpmn:sourceRef>
        <bpmn:targetRef>A3_Doc4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A3_T31d_Performer">
        <bpmn:resourceRef>Resource_R4</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A3_M31r" name="" gatewayDirection="Converging">
      <bpmn:incoming>A3_F3</bpmn:incoming>
      <bpmn:incoming>A3_F6</bpmn:incoming>
      <bpmn:outgoing>A3_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A3_T31r" name="Передать инструкции; зарегистрировать готовность магазинов">
      <bpmn:documentation>Функция A31. Digital-специалист готовит сегмент и email в BPMSoft, цифровые размещения — в рекламном кабинете. Trade-маркетолог передаёт инструкции из карточки через подключённую почту. Ответы магазинов сохраняются в истории кампании; сотрудник проверяет готовность.
Механизмы: Специалист digital-коммуникаций; Trade-маркетолог; Руководитель магазина; Персональный компьютер; BPMSoft; Рекламный кабинет.
Входы: Согласованные рекламные материалы; Список клиентских контактов; Подтверждения готовности магазинов.
Результаты: Параметры цифровых размещений; Подготовленные email-сообщения; Список адресатов рассылки; Инструкции для магазинов; Подтверждения готовности каналов; Рекламные материалы, переданные магазинам.
Управление: Согласованный электронный медиаплан; Технические требования каналов размещения; Требования к рекламе; Требования к обработке персональных данных; Требования к информации о товарах; Решение о согласовании версий; Данные мониторинга в карточке кампании.</bpmn:documentation>
      <bpmn:incoming>A3_F4</bpmn:incoming>
      <bpmn:outgoing>A3_F5</bpmn:outgoing>
      <bpmn:ioSpecification id="A3_T31r_IO">
        <bpmn:dataInput id="A3_Data_2_Item" name="Согласованные материалы [вход из A2]"/>
        <bpmn:dataInput id="A3_Data_31_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataInput id="A3_Data_33_Item" name="История коммуникаций в BPMSoft"/>
        <bpmn:dataOutput id="A3_Data_10_Item" name="Инструкции для магазинов"/>
        <bpmn:dataOutput id="A3_Data_12_Item" name="Подтверждения готовности магазинов"/>
        <bpmn:dataOutput id="A3_Data_34_Item" name="История коммуникаций в BPMSoft"/>
        <bpmn:inputSet id="A3_T31r_InputSet">
