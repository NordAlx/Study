<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A4" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Контакты и согласия в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_MailingLog" name="История рассылок в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Карточки, версии документов и результаты в BPMSoft" isUnlimited="true"/>
  <bpmn:dataStore id="Store_CorporateMail" name="История коммуникаций в BPMSoft" isUnlimited="true"/>
  <bpmn:process id="Process_A4" name="Оценить результаты рекламной кампании" isExecutable="false">
    <bpmn:documentation>Учебная модель TO BE: единый рабочий контур BPMSoft. Настроенные поля, шаблоны, маршруты, подключённая почта, рассылки и аналитика. Автоматическое получение внешних рекламных показателей не предполагается; выгрузки проверяет сотрудник. Пользовательские задачи сохраняют человеческие решения; автоматическое формирование проекта отчёта выделено отдельно. isExecutable=false.</bpmn:documentation>
    <bpmn:laneSet id="A4_LaneSet">
      <bpmn:lane id="A4_Lane_R6" name="Маркетинговый аналитик">
        <bpmn:flowNodeRef>A4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_M41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_A41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_G41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_A42</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A4_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A4_A43</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_End</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>A4_ReportDraft</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A4_Start" name="Период завершён; мониторинг подготовлен">
      <bpmn:outgoing>A4_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A4_M41" name="" gatewayDirection="Converging">
      <bpmn:incoming>A4_F1</bpmn:incoming>
      <bpmn:incoming>A4_F5</bpmn:incoming>
      <bpmn:outgoing>A4_F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A4_A41" name="Собрать результаты рекламной кампании">
      <bpmn:documentation>Функция A41. Аналитик проверяет результаты и загруженную выгрузку продаж в BPMSoft. Система объединяет данные кампании; недостающие сведения запрашиваются через её историю коммуникаций.
Механизмы: Менеджер рекламной кампании; Специалист digital-коммуникаций; Trade-маркетолог; Маркетинговый аналитик; Категорийный менеджер; Персональный компьютер; BPMSoft.
Входы: Данные мониторинга в карточке кампании; Данные цифровых каналов; Данные розничных размещений; Данные о продажах.
Результаты: Сводные результаты в карточке кампании.
Управление: Методика оценки результатов кампании; Требования к отчётности.</bpmn:documentation>
      <bpmn:incoming>A4_F2</bpmn:incoming>
      <bpmn:outgoing>A4_F3</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A41_IO">
        <bpmn:dataInput id="A4_Data_1_Item" name="Данные мониторинга [вход из A3]"/>
        <bpmn:dataInput id="A4_Data_2_Item" name="Данные о продажах [коммерческий блок]"/>
        <bpmn:dataInput id="A4_Data_9_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataInput id="A4_Data_11_Item" name="История коммуникаций в BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_3_Item" name="Сводные результаты кампании (BPMSoft)"/>
        <bpmn:inputSet id="A4_A41_InputSet">
          <bpmn:dataInputRefs>A4_Data_1_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_2_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_9_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_11_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A4_A41_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_3_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A4_Data_1">
        <bpmn:sourceRef>A4_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_1_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A4_Data_2">
        <bpmn:sourceRef>A4_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_2_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A4_Data_9">
        <bpmn:sourceRef>A4_Store6</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_9_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A4_Data_11">
        <bpmn:sourceRef>A4_Store7</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_11_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A4_Data_3">
        <bpmn:sourceRef>A4_Data_3_Item</bpmn:sourceRef>
        <bpmn:targetRef>A4_Doc3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A41_Performer">
        <bpmn:resourceRef>Resource_R6</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A4_G41" name="Данные полны и сопоставимы?" gatewayDirection="Diverging">
      <bpmn:incoming>A4_F3</bpmn:incoming>
      <bpmn:outgoing>A4_F4</bpmn:outgoing>
      <bpmn:outgoing>A4_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A4_A42" name="Проверить показатели и оценить эффективность в BPMSoft">
      <bpmn:documentation>Функция A42. BPMSoft рассчитывает настроенные показатели и формирует аналитические представления. Аналитик проверяет корректность данных и интерпретирует результаты; внешние таблицы и дополнительный аналитический инструмент не требуются.
Механизмы: Маркетинговый аналитик; Персональный компьютер; BPMSoft.
Входы: Сводные результаты в карточке кампании.
Результаты: Аналитика эффективности рекламной кампании.
Управление: Электронный бриф рекламной кампании; Согласованный электронный медиаплан; Утверждённый бюджетный лимит; Методика оценки результатов кампании.</bpmn:documentation>
      <bpmn:incoming>A4_F4</bpmn:incoming>
      <bpmn:outgoing>A4_F6</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A42_IO">
        <bpmn:dataInput id="A4_Data_4_Item" name="Сводные результаты кампании (BPMSoft)"/>
        <bpmn:dataOutput id="A4_Data_6_Item" name="Аналитика эффективности"/>
        <bpmn:inputSet id="A4_A42_InputSet">
          <bpmn:dataInputRefs>A4_Data_4_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A4_A42_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_6_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A4_Data_4">
        <bpmn:sourceRef>A4_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_4_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="A4_Data_6">
        <bpmn:sourceRef>A4_Data_6_Item</bpmn:sourceRef>
        <bpmn:targetRef>A4_Doc4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A42_Performer">
        <bpmn:resourceRef>Resource_R6</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:serviceTask id="A4_ReportDraft" name="Сформировать проект отчёта из карточки"><bpmn:documentation>Техническое действие внутри A43 после настройки шаблона и процесса. Источник — сохранённые результаты и аналитика. Система формирует проект; выводы и итоговую отправку проверяет менеджер. Сервисная задача не означает автоматический анализ бизнеса.</bpmn:documentation><bpmn:incoming>A4_F6</bpmn:incoming><bpmn:outgoing>A4_ReportDraft_ToReview</bpmn:outgoing><bpmn:ioSpecification id="A4_ReportDraft_IO"><bpmn:dataInput id="A4_ReportDraft_CardInput_Item" name="Карточки, версии документов и результаты в BPMSoft"/><bpmn:dataOutput id="A4_ReportDraft_Output_Item" name="Проект итогового отчёта"/><bpmn:inputSet id="A4_ReportDraft_InputSet"><bpmn:dataInputRefs>A4_ReportDraft_CardInput_Item</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="A4_ReportDraft_OutputSet"><bpmn:dataOutputRefs>A4_ReportDraft_Output_Item</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataInputAssociation id="A4_ReportDraft_CardInput"><bpmn:sourceRef>A4_Store6</bpmn:sourceRef><bpmn:targetRef>A4_ReportDraft_CardInput_Item</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="A4_ReportDraft_Output"><bpmn:sourceRef>A4_ReportDraft_Output_Item</bpmn:sourceRef><bpmn:targetRef>A4_ReportDraft_Data</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:userTask id="A4_A43" name="Проверить и передать итоговый отчёт из BPMSoft">
      <bpmn:documentation>Функция A43. BPMSoft формирует проект отчёта из карточки и показателей. Аналитик и менеджер проверяют выводы; отчёт передаётся директору через систему и категорийному менеджеру через подключённую почту. Факт передачи обоим получателям фиксируется в карточке.
Механизмы: Менеджер рекламной кампании; Маркетинговый аналитик; Персональный компьютер; BPMSoft.
Входы: Сводные результаты в карточке кампании; Аналитика эффективности рекламной кампании.
Результаты: Итоговый отчёт, сформированный и переданный из BPMSoft.
Управление: Требования к отчётности.</bpmn:documentation>
      <bpmn:incoming>A4_ReportDraft_ToReview</bpmn:incoming>
      <bpmn:outgoing>A4_F7</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A43_IO">
        <bpmn:dataInput id="A4_Data_5_Item" name="Сводные результаты кампании (BPMSoft)"/>
        <bpmn:dataInput id="A4_Data_7_Item" name="Аналитика эффективности"/>
        <bpmn:dataInput id="A4_ReportDraft_Input_Item" name="Проект итогового отчёта"/><bpmn:dataOutput id="A4_Data_8_Item" name="Итоговый отчёт (BPMSoft)"/>
        <bpmn:dataOutput id="A4_Data_10_Item" name="Карточки и версии документов в BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_12_Item" name="История коммуникаций в BPMSoft"/>
        <bpmn:inputSet id="A4_A43_InputSet">
          <bpmn:dataInputRefs>A4_Data_5_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_7_Item</bpmn:dataInputRefs>
        <bpmn:dataInputRefs>A4_ReportDraft_Input_Item</bpmn:dataInputRefs></bpmn:inputSet>
        <bpmn:outputSet id="A4_A43_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_8_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A4_Data_10_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A4_Data_12_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="A4_Data_5">
        <bpmn:sourceRef>A4_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_5_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A4_Data_7">
        <bpmn:sourceRef>A4_Doc4</bpmn:sourceRef>
        <bpmn:targetRef>A4_Data_7_Item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="A4_ReportDraft_Input"><bpmn:sourceRef>A4_ReportDraft_Data</bpmn:sourceRef><bpmn:targetRef>A4_ReportDraft_Input_Item</bpmn:targetRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="A4_Data_8">
        <bpmn:sourceRef>A4_Data_8_Item</bpmn:sourceRef>
        <bpmn:targetRef>A4_Doc5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A4_Data_10">
        <bpmn:sourceRef>A4_Data_10_Item</bpmn:sourceRef>
        <bpmn:targetRef>A4_Store6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="A4_Data_12">
        <bpmn:sourceRef>A4_Data_12_Item</bpmn:sourceRef>
        <bpmn:targetRef>A4_Store7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A43_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:endEvent id="A4_End" name="Итоговый отчёт сформирован и передан">
      <bpmn:incoming>A4_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="A4_Doc1_Object" name="Данные мониторинга [вход из A3]"/>
    <bpmn:dataObjectReference id="A4_Doc1" name="Данные мониторинга [вход из A3]" dataObjectRef="A4_Doc1_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A4_Doc2_Object" name="Данные о продажах [коммерческий блок]"/>
    <bpmn:dataObjectReference id="A4_Doc2" name="Данные о продажах [коммерческий блок]" dataObjectRef="A4_Doc2_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A4_Doc3_Object" name="Сводные результаты кампании (BPMSoft)"/>
    <bpmn:dataObjectReference id="A4_Doc3" name="Сводные результаты кампании (BPMSoft)" dataObjectRef="A4_Doc3_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A4_Doc4_Object" name="Аналитика эффективности"/>
    <bpmn:dataObjectReference id="A4_Doc4" name="Аналитика эффективности" dataObjectRef="A4_Doc4_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="A4_Doc5_Object" name="Итоговый отчёт (BPMSoft)"/>
    <bpmn:dataObjectReference id="A4_Doc5" name="Итоговый отчёт (BPMSoft)" dataObjectRef="A4_Doc5_Object">
      <bpmn:documentation>Вход родительского контекста или результат указанной задачи.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="A4_Store6" name="Карточки, версии документов и результаты в BPMSoft" dataStoreRef="Store_CampaignDocuments">
      <bpmn:documentation>Постоянное раздельное хранилище; существует до текущей кампании.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="A4_Store7" name="История коммуникаций в BPMSoft" dataStoreRef="Store_CorporateMail">
      <bpmn:documentation>Постоянное раздельное хранилище; существует до текущей кампании.</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="A4_F1" sourceRef="A4_Start" targetRef="A4_M41"/>
    <bpmn:sequenceFlow id="A4_F2" sourceRef="A4_M41" targetRef="A4_A41"/>
    <bpmn:sequenceFlow id="A4_F3" sourceRef="A4_A41" targetRef="A4_G41"/>
    <bpmn:sequenceFlow id="A4_F4" sourceRef="A4_G41" targetRef="A4_A42" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A4_F5" sourceRef="A4_G41" targetRef="A4_M41" name="Уточнить показатели">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Уточнить показатели</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="A4_F6" sourceRef="A4_A42" targetRef="A4_ReportDraft"/>
    <bpmn:sequenceFlow id="A4_F7" sourceRef="A4_A43" targetRef="A4_End"/>
    <bpmn:sequenceFlow id="A4_ReportDraft_ToReview" sourceRef="A4_ReportDraft" targetRef="A4_A43"/><bpmn:dataObject id="A4_ReportDraft_Object" name="Проект итогового отчёта"/><bpmn:dataObjectReference id="A4_ReportDraft_Data" name="Проект итогового отчёта" dataObjectRef="A4_ReportDraft_Object"/><bpmn:textAnnotation id="A4_ResourcesNote">
      <bpmn:text>TO BE: единая карточка BPMSoft; электронные бриф и медиаплан; версии и согласование; встроенные коммуникации и рассылки; показатели и отчётность. Сотрудники проверяют данные и принимают решения. Графический редактор используется для макетов, рекламный кабинет — для размещений, веб-аналитика — как источник показателей. Отдельные офисные приложения и почтовый клиент не используются.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A4_ResourcesNote_Association" sourceRef="A4_ResourcesNote" targetRef="A4_A41" associationDirection="None"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_A4">
    <bpmn:participant id="Participant_A4" name="Департамент маркетинга и рекламы" processRef="Process_A4"/>
    <bpmn:participant id="Participant_S1" name="Коммерческий блок — Категорийный менеджер">
      <bpmn:documentation>Смежный участник. Внутренние операции не показаны.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="A4_Message_1" name="Запрос данных о продажах" sourceRef="A4_A41" targetRef="Participant_S1"/>
    <bpmn:messageFlow id="A4_Message_2" name="Данные о продажах" sourceRef="Participant_S1" targetRef="A4_A41"/>
    <bpmn:messageFlow id="A4_Message_3" name="Итоговый отчёт, сформированный и переданный из BPMSoft" sourceRef="A4_A43" targetRef="Participant_S1"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_A4">
    <bpmndi:BPMNPlane id="Plane_A4" bpmnElement="Collaboration_A4">
      <bpmndi:BPMNShape id="Participant_A4_di" bpmnElement="Participant_A4" isHorizontal="true">
