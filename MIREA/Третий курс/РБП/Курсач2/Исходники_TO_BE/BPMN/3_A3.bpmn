<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Print_Defs_A3" targetNamespace="urn:gloria:to-be:print"><bpmn:process id="Print_Process_A3" isExecutable="false"><bpmn:documentation>Печатное представление той же функциональной модели: четырнадцать основных операций, единый контур BPMSoft, те же исходы и исполнители. Входы и результаты подробно показаны в IDEF0. Содержательные решения принимают сотрудники.</bpmn:documentation><bpmn:laneSet id="LaneSet_A3"><bpmn:lane id="Lane_A3_0" name="Специалист digital-коммуникаций; Trade-маркетолог"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>A31</bpmn:flowNodeRef><bpmn:flowNodeRef>A32</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_A3_1" name="Менеджер рекламной кампании"><bpmn:flowNodeRef>Join</bpmn:flowNodeRef><bpmn:flowNodeRef>A33</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Next</bpmn:flowNodeRef><bpmn:flowNodeRef>Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Change</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start" name="Медиаплан и рекламные материалы согласованы"><bpmn:outgoing>bpmn_flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="A31" name="Подготовить каналы и проверить готовность в BPMSoft"><bpmn:documentation>Digital-специалист готовит сегмент и email в BPMSoft, цифровые размещения — в рекламном кабинете. Trade-маркетолог передаёт инструкции из карточки через подключённую почту. Ответы магазинов сохраняются в истории кампании; сотрудник проверяет готовность.</bpmn:documentation><bpmn:incoming>bpmn_flow_0</bpmn:incoming><bpmn:outgoing>bpmn_flow_7</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="A32" name="Запустить размещения и утверждённую рассылку"><bpmn:documentation>Digital-специалист запускает утверждённую рассылку в BPMSoft и размещения в рекламном кабинете. Trade-маркетолог проверяет подтверждения магазинов в карточке. Почтовый клиент и отдельный журнал отправок не используются.</bpmn:documentation><bpmn:incoming>bpmn_flow_7</bpmn:incoming><bpmn:outgoing>bpmn_flow_8</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Join" name=""><bpmn:incoming>bpmn_flow_8</bpmn:incoming><bpmn:incoming>bpmn_flow_6</bpmn:incoming><bpmn:outgoing>bpmn_flow_1</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="A33" name="Контролировать и корректировать кампанию в BPMSoft"><bpmn:documentation>Показатели рекламного кабинета и веб-аналитики проверяются и импортируются в BPMSoft. Система формирует сводку и контрольные задачи; менеджер анализирует отклонения. Исправления выполняются в каналах и фиксируются в карточке; изменение условий возвращается на согласование.</bpmn:documentation><bpmn:incoming>bpmn_flow_1</bpmn:incoming><bpmn:outgoing>bpmn_flow_2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Decision" name=""><bpmn:incoming>bpmn_flow_2</bpmn:incoming><bpmn:outgoing>bpmn_flow_4</bpmn:outgoing><bpmn:outgoing>bpmn_flow_5</bpmn:outgoing><bpmn:outgoing>bpmn_flow_3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:intermediateCatchEvent id="Next" name="Кампания продолжается; назначена очередная проверка"><bpmn:incoming>bpmn_flow_5</bpmn:incoming><bpmn:outgoing>bpmn_flow_6</bpmn:outgoing><bpmn:timerEventDefinition id="Next_Timer"><bpmn:timeDate xsi:type="bpmn:tFormalExpression">NextControlDateFromMediaPlan</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:endEvent id="Complete" name="Период кампании завершён; данные мониторинга подготовлены"><bpmn:incoming>bpmn_flow_3</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="Change" name="Требуется повторное согласование изменённых условий"><bpmn:incoming>bpmn_flow_4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="bpmn_flow_0" sourceRef="Start" targetRef="A31"/><bpmn:sequenceFlow id="bpmn_flow_1" sourceRef="Join" targetRef="A33"/><bpmn:sequenceFlow id="bpmn_flow_2" sourceRef="A33" targetRef="Decision"/><bpmn:sequenceFlow id="bpmn_flow_7" sourceRef="A31" targetRef="A32" name="Цифровые каналы и магазины готовы к запуску"/><bpmn:sequenceFlow id="bpmn_flow_8" sourceRef="A32" targetRef="Join"/><bpmn:sequenceFlow id="bpmn_flow_6" sourceRef="Next" targetRef="Join"/><bpmn:sequenceFlow id="bpmn_flow_4" sourceRef="Decision" targetRef="Change" name="Согласовано"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'Согласовано'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="bpmn_flow_5" sourceRef="Decision" targetRef="Next"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'bpmn_flow_5'</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="bpmn_flow_3" sourceRef="Decision" targetRef="Complete" name="Период завершён"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Route == 'Период завершён'</bpmn:conditionExpression></bpmn:sequenceFlow></bpmn:process><bpmn:collaboration id="Collab_A3"><bpmn:participant id="Participant_Print_A3" name="Департамент маркетинга и рекламы" processRef="Print_Process_A3"/><bpmn:participant id="Participant_Adjacent_A3" name="Магазины — Руководитель магазина"/><bpmn:messageFlow id="Message_A3_0" sourceRef="A31" targetRef="Participant_Adjacent_A3" name="Инструкции и статусы"/><bpmn:messageFlow id="Message_A3_0_Reply" sourceRef="Participant_Adjacent_A3" targetRef="A31" name="Подтверждения и показатели"/><bpmn:messageFlow id="Message_A3_1" sourceRef="A32" targetRef="Participant_Adjacent_A3" name="Инструкции и статусы"/><bpmn:messageFlow id="Message_A3_1_Reply" sourceRef="Participant_Adjacent_A3" targetRef="A32" name="Подтверждения и показатели"/><bpmn:messageFlow id="Message_A3_2" sourceRef="A33" targetRef="Participant_Adjacent_A3" name="Инструкции и статусы"/><bpmn:messageFlow id="Message_A3_2_Reply" sourceRef="Participant_Adjacent_A3" targetRef="A33" name="Подтверждения и показатели"/></bpmn:collaboration><bpmndi:BPMNDiagram id="Diagram_Print_A3"><bpmndi:BPMNPlane id="Plane_Print_A3" bpmnElement="Collab_A3"><bpmndi:BPMNShape id="DI_Participant_Print_A3" bpmnElement="Participant_Print_A3" isHorizontal="true"><dc:Bounds x="181.0" y="-8.0" width="1644.0" height="917.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_A3_0" bpmnElement="Lane_A3_0" isHorizontal="true"><dc:Bounds x="213.0" y="-8.0" width="1612.0" height="460.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Lane_A3_1" bpmnElement="Lane_A3_1" isHorizontal="true"><dc:Bounds x="213.0" y="452.0" width="1612.0" height="457.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Start" bpmnElement="Start"><dc:Bounds x="768.0" y="102.0" width="64.0" height="64.0"/><bpmndi:BPMNLabel><dc:Bounds x="675.0" y="36.0" width="250" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_A31" bpmnElement="A31"><dc:Bounds x="660.0" y="186.0" width="280.0" height="100.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_A32" bpmnElement="A32"><dc:Bounds x="660.0" y="306.0" width="280.0" height="100.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Join" bpmnElement="Join"><dc:Bounds x="774.0" y="426.0" width="52.0" height="52.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_A33" bpmnElement="A33"><dc:Bounds x="660.0" y="498.0" width="280.0" height="100.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Decision" bpmnElement="Decision"><dc:Bounds x="774.0" y="618.0" width="52.0" height="52.0"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Next" bpmnElement="Next"><dc:Bounds x="408.0" y="690.0" width="64.0" height="64.0"/><bpmndi:BPMNLabel><dc:Bounds x="315.0" y="761.0" width="250" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Complete" bpmnElement="Complete"><dc:Bounds x="1128.0" y="690.0" width="64.0" height="64.0"/><bpmndi:BPMNLabel><dc:Bounds x="1035.0" y="761.0" width="250" height="57"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNShape id="DI_Change" bpmnElement="Change"><dc:Bounds x="1488.0" y="690.0" width="64.0" height="64.0"/><bpmndi:BPMNLabel><dc:Bounds x="1395.0" y="761.0" width="250" height="57"/></bpmndi:BPMNLabel></bpmndi:BPMNShape><bpmndi:BPMNEdge id="DI_bpmn_flow_0" bpmnElement="bpmn_flow_0"><di:waypoint x="800.0" y="166.0"/><di:waypoint x="800.0" y="178.0"/><di:waypoint x="800.0" y="174.0"/><di:waypoint x="800.0" y="186.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_1" bpmnElement="bpmn_flow_1"><di:waypoint x="800.0" y="478.0"/><di:waypoint x="800.0" y="490.0"/><di:waypoint x="800.0" y="486.0"/><di:waypoint x="800.0" y="498.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_2" bpmnElement="bpmn_flow_2"><di:waypoint x="800.0" y="598.0"/><di:waypoint x="800.0" y="610.0"/><di:waypoint x="800.0" y="606.0"/><di:waypoint x="800.0" y="618.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_7" bpmnElement="bpmn_flow_7"><di:waypoint x="800.0" y="286.0"/><di:waypoint x="800.0" y="298.0"/><di:waypoint x="800.0" y="294.0"/><di:waypoint x="800.0" y="306.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_8" bpmnElement="bpmn_flow_8"><di:waypoint x="800.0" y="406.0"/><di:waypoint x="800.0" y="418.0"/><di:waypoint x="800.0" y="414.0"/><di:waypoint x="800.0" y="426.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_6" bpmnElement="bpmn_flow_6"><di:waypoint x="411.37832988800267" y="736.3108350559986"/><di:waypoint x="396.0" y="738.0"/><di:waypoint x="396.0" y="452.0"/><di:waypoint x="762.0" y="452.0"/><di:waypoint x="774.0" y="452.0"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="DI_bpmn_flow_4" bpmnElement="bpmn_flow_4"><di:waypoint x="819.5" y="650.5"/><di:waypoint x="838.0" y="652.6666666666666"/><di:waypoint x="1476.0" y="652.6666666666666"/><di:waypoint x="1476.0" y="706.0"/><di:waypoint x="1491.3783298880028" y="707.6891649440014"/><bpmndi:BPMNLabel><dc:Bounds x="1090.0" y="626.6666666666666" width="135" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id