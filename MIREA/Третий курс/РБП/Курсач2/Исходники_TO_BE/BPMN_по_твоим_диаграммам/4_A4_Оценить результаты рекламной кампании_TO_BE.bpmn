<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_A4" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Клиентские контакты BPMSoft"/>
  <bpmn:dataStore id="Store_MailingLog" name="Журнал рассылок BPMSoft"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Карточки и материалы BPMSoft"/>
  <bpmn:dataStore id="Store_CorporateMail" name="История коммуникаций BPMSoft"/>
  <bpmn:process id="Process_A4" name="Оценить результаты рекламной кампании — TO BE" isExecutable="false">
    <bpmn:documentation>Учебная целевая модель с BPMSoft. Сохранены исполнители, границы, документные связи и маршруты исходной модели. Карточка, задачи, электронные документы, контакты и история коммуникаций ведутся в одной системе; изображения хранилищ представляют логические наборы данных BPMSoft. Графический редактор, рекламный кабинет и сервис веб-аналитики используются для специализированных операций. Внешние сведения импортируются сотрудниками; файл не предназначен для исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="A4_LaneSet">
      <bpmn:lane id="A4_Lane_R6" name="Маркетинговый аналитик">
        <bpmn:flowNodeRef>A4_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_M41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_A41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_G41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_A42</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A4_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A4_A43</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A4_Start" name="Период завершён; мониторинг подготовлен">
      <bpmn:outgoing>A4_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A4_M41" name="" gatewayDirection="Converging">
      <bpmn:incoming>A4_F1</bpmn:incoming>
      <bpmn:incoming>A4_F5</bpmn:incoming>
      <bpmn:outgoing>A4_F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A4_A41" name="Проверить сводку результатов в BPMSoft">
      <bpmn:documentation>Аналитик использует сохранённые данные мониторинга BPMSoft, импортирует сведения о продажах от коммерческого блока и проверяет период, товары и полноту. Настроенная сводка использует данные карточки; недостающие сведения уточняются.
Исполнитель: Маркетинговый аналитик.
Средства: Персональный компьютер; BPMSoft.
Входы: Данные мониторинга BPMSoft; Данные цифровых каналов; Данные розничных размещений; Данные о продажах.
Результаты: Сводка результатов BPMSoft.
Основания: Методика оценки результатов кампании; Требования к отчётности.</bpmn:documentation>
      <bpmn:incoming>A4_F2</bpmn:incoming>
      <bpmn:outgoing>A4_F3</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A41_IO">
        <bpmn:dataInput id="A4_Data_1_Item" name="Данные мониторинга BPMSoft [вход из A3]"/>
        <bpmn:dataInput id="A4_Data_2_Item" name="Данные о продажах [коммерческий блок]"/>
        <bpmn:dataInput id="A4_Data_9_Item" name="Карточки и материалы BPMSoft"/>
        <bpmn:dataInput id="A4_Data_11_Item" name="История коммуникаций BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_3_Item" name="Сводка результатов BPMSoft"/>
        <bpmn:inputSet id="A4_A41_InputSet">
          <bpmn:dataInputRefs>A4_Data_1_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_2_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_9_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_11_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A4_A41_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_3_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:property id="Property_1l832p9" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_15jgcis">
        <bpmn:sourceRef>A4_Doc2</bpmn:sourceRef>
        <bpmn:targetRef>Property_1l832p9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_17k3pu6">
        <bpmn:sourceRef>A4_Store6</bpmn:sourceRef>
        <bpmn:targetRef>Property_1l832p9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_1okxzol">
        <bpmn:sourceRef>A4_Store7</bpmn:sourceRef>
        <bpmn:targetRef>Property_1l832p9</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1fkzr3b">
        <bpmn:targetRef>A4_Doc1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1mzu3u6">
        <bpmn:targetRef>A4_Doc3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A41_Performer">
        <bpmn:resourceRef>Resource_R6</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="A4_G41" name="Данные полны и сопоставимы?" gatewayDirection="Diverging">
      <bpmn:incoming>A4_F3</bpmn:incoming>
      <bpmn:outgoing>A4_F4</bpmn:outgoing>
      <bpmn:outgoing>A4_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A4_A42" name="Оценить эффективность в BPMSoft">
      <bpmn:documentation>Аналитик проверяет рассчитанные по настроенным правилам показатели и интерпретирует результаты в BPMSoft. Методика оценки сохраняется. Система не заменяет содержательный анализ сотрудника.
Исполнитель: Маркетинговый аналитик.
Средства: Персональный компьютер; BPMSoft.
Входы: Сводка результатов BPMSoft.
Результаты: Аналитика эффективности BPMSoft рекламной кампании.
Основания: Электронный бриф; Согласованный электронный медиаплан; Утверждённый бюджетный лимит; Методика оценки результатов кампании.</bpmn:documentation>
      <bpmn:incoming>A4_F4</bpmn:incoming>
      <bpmn:outgoing>A4_F6</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A42_IO">
        <bpmn:dataInput id="A4_Data_4_Item" name="Сводка результатов BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_6_Item" name="Аналитика эффективности BPMSoft"/>
        <bpmn:inputSet id="A4_A42_InputSet">
          <bpmn:dataInputRefs>A4_Data_4_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A4_A42_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_6_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:property id="Property_0131ngf" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_1906t0a">
        <bpmn:sourceRef>A4_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>Property_0131ngf</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0wda6n8">
        <bpmn:targetRef>A4_Doc4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A42_Performer">
        <bpmn:resourceRef>Resource_R6</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:userTask id="A4_A43" name="Проверить и передать отчёт в BPMSoft">
      <bpmn:documentation>В рамках данной операции BPMSoft формирует проект отчёта из сохранённых данных по настроенному шаблону. Менеджер при участии аналитика проверяет содержание и передаёт отчёт директору в системе и категорийному менеджеру через подключённую корпоративную почту. Завершение означает передачу обоим получателям. Автоматический помощник внутри операции не означает автоматического принятия аналитического решения.
Исполнитель: Менеджер рекламной кампании.
Средства: Персональный компьютер; BPMSoft.
Входы: Сводка результатов BPMSoft; Аналитика эффективности BPMSoft рекламной кампании.
Результаты: Итоговый отчёт BPMSoft.
Основания: Требования к отчётности.</bpmn:documentation>
      <bpmn:incoming>A4_F6</bpmn:incoming>
      <bpmn:outgoing>A4_F7</bpmn:outgoing>
      <bpmn:ioSpecification id="A4_A43_IO">
        <bpmn:dataInput id="A4_Data_5_Item" name="Сводка результатов BPMSoft"/>
        <bpmn:dataInput id="A4_Data_7_Item" name="Аналитика эффективности BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_8_Item" name="Итоговый отчёт BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_10_Item" name="Карточки и материалы BPMSoft"/>
        <bpmn:dataOutput id="A4_Data_12_Item" name="История коммуникаций BPMSoft"/>
        <bpmn:inputSet id="A4_A43_InputSet">
          <bpmn:dataInputRefs>A4_Data_5_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A4_Data_7_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A4_A43_OutputSet">
          <bpmn:dataOutputRefs>A4_Data_8_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A4_Data_10_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A4_Data_12_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:property id="Property_0ornnmn" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DataInputAssociation_04nwxe2">
        <bpmn:sourceRef>A4_Doc3</bpmn:sourceRef>
        <bpmn:targetRef>Property_0ornnmn</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_1m05j5f">
        <bpmn:sourceRef>A4_Doc4</bpmn:sourceRef>
        <bpmn:targetRef>Property_0ornnmn</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_18x7qkt">
        <bpmn:targetRef>A4_Doc5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0enihv5">
        <bpmn:targetRef>A4_Store6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0ckivgc">
        <bpmn:targetRef>A4_Store7</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:performer id="A4_A43_Performer">
        <bpmn:resourceRef>Resource_R2</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:userTask>
