<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_A2" targetNamespace="https://mirea.example/gloria-jeans/as-is" exporter="Coursework BPMN authoring" exporterVersion="1.0">
  <bpmn:resource id="Resource_R1" name="Директор департамента маркетинга и рекламы"/>
  <bpmn:resource id="Resource_R2" name="Менеджер рекламной кампании"/>
  <bpmn:resource id="Resource_R3" name="Специалист по разработке рекламных материалов"/>
  <bpmn:resource id="Resource_R4" name="Специалист digital-коммуникаций"/>
  <bpmn:resource id="Resource_R5" name="Trade-маркетолог"/>
  <bpmn:resource id="Resource_R6" name="Маркетинговый аналитик"/>
  <bpmn:resource id="Resource_S1" name="Категорийный менеджер"/>
  <bpmn:resource id="Resource_S2" name="Руководитель магазина"/>
  <bpmn:dataStore id="Store_ClientContacts" name="Клиентские контакты BPMSoft"/>
  <bpmn:dataStore id="Store_MailingLog" name="Журнал рассылок BPMSoft"/>
  <bpmn:dataStore id="Store_CampaignDocuments" name="Карточки и материалы BPMSoft"/>
  <bpmn:dataStore id="Store_CorporateMail" name="История коммуникаций BPMSoft"/>
  <bpmn:process id="Process_A2" name="Разработать рекламную кампанию — TO BE" isExecutable="false">
    <bpmn:documentation>Учебная целевая модель с BPMSoft. Сохранены исполнители, границы, документные связи и маршруты исходной модели. Карточка, задачи, электронные документы, контакты и история коммуникаций ведутся в одной системе; изображения хранилищ представляют логические наборы данных BPMSoft. Графический редактор, рекламный кабинет и сервис веб-аналитики используются для специализированных операций. Внешние сведения импортируются сотрудниками; файл не предназначен для исполнения в движке.</bpmn:documentation>
    <bpmn:laneSet id="A2_LaneSet">
      <bpmn:lane id="A2_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A2_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_M22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_M24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_Submit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A2_Lane_R3" name="Специалист по разработке рекламных материалов">
        <bpmn:flowNodeRef>A2_M23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_A23</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A2_Lane_R1" name="Директор департамента маркетинга и рекламы">
        <bpmn:flowNodeRef>A2_A24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A2_G25</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A2_Start" name="Получен бриф или запрос изменений">
      <bpmn:outgoing>A2_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A2_G20" name="Первичная разработка?" gatewayDirection="Diverging">
      <bpmn:incoming>A2_F1</bpmn:incoming>
      <bpmn:outgoing>A2_F2</bpmn:outgoing>
      <bpmn:outgoing>A2_F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A2_A21" name="Разработать концепцию в BPMSoft">
      <bpmn:documentation>Менеджер разрабатывает концепцию и сохраняет её в карточке BPMSoft. При повторном входе используются сохранённые данные и версии; идея остаётся результатом работы сотрудника.
Исполнитель: Менеджер рекламной кампании.
Средства: Персональный компьютер; BPMSoft.
Входы: Электронный бриф; Исходные данные BPMSoft.
Результаты: Концепция в BPMSoft.
Основания: Брендбук; Маркетинговая стратегия; Требования к рекламе; Требования к информации о товарах.</bpmn:documentation>
      <bpmn:incoming>A2_F2</bpmn:incoming>
      <bpmn:outgoing>A2_F4</bpmn:outgoing>
      <bpmn:ioSpecification id="A2_A21_IO">
        <bpmn:dataInput id="A2_Data_1_Item" name="Бриф [вход из A1]"/>
        <bpmn:dataInput id="A2_Data_23_Item" name="Карточки и материалы BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_5_Item" name="Концепция в BPMSoft"/>
        <bpmn:dataOutput id="A2_Data_24_Item" name="Карточки и материалы BPMSoft"/>
