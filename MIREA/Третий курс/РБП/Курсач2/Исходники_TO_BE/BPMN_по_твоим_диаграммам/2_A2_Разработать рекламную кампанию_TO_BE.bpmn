        <bpmn:sourceRef>A2_Doc1</bpmn:sourceRef>
        <bpmn:targetRef>Property_0d6jgft</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_05hq8ni">
        <bpmn:sourceRef>A2_Store10</bpmn:sourceRef>
        <bpmn:targetRef>Property_0d6jgft</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0lpsv6e">
        <bpmn:targetRef>A2_Doc2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_006gpy3">
