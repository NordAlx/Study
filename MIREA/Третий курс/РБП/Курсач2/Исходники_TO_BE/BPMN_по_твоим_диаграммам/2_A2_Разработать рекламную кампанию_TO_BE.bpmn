          <bpmn:dataInputRefs>A2_Data_23_Item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="A2_A21_OutputSet">
          <bpmn:dataOutputRefs>A2_Data_5_Item</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>A2_Data_24_Item</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
