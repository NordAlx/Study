        <bpmn:dataInput id="A3_Data_31_Item" name="Карточки и материалы BPMSoft"/>
        <bpmn:dataInput id="A3_Data_33_Item" name="История коммуникаций BPMSoft"/>
        <bpmn:dataOutput id="A3_Data_10_Item" name="Инструкции для магазинов"/>
        <bpmn:dataOutput id="A3_Data_12_Item" name="Подтверждения готовности магазинов"/>
        <bpmn:dataOutput id="A3_Data_34_Item" name="История коммуникаций BPMSoft"/>
        <bpmn:inputSet id="A3_T31r_InputSet">
