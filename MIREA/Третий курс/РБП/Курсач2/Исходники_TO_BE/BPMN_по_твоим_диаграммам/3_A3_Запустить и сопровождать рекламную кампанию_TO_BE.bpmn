        <bpmn:flowNodeRef>A3_G32r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33dataR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G31r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_T33r</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="A3_Lane_R2" name="Менеджер рекламной кампании">
        <bpmn:flowNodeRef>A3_Start</bpmn:flowNodeRef>
