        <bpmn:flowNodeRef>A3_G33b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_G33c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_P33</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3_CheckDate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A3_Start" name="Медиаплан и рекламные материалы согласованы">
      <bpmn:outgoing>A3_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="A3_P31" name="" gatewayDirection="Diverging">
      <bpmn:incoming>A3_F1</bpmn:incoming>
      <bpmn:outgoing>A3_F2</bpmn:outgoing>
      <bpmn:outgoing>A3_F3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="A3_T31d" name="Подготовить размещения и email-рассылку">
      <bpmn:documentation>Digital-специалист выбирает сегмент контактов и готовит email-сообщения в BPMSoft. Цифровые размещения настраивает в рекламном кабинете. Проверяет согласованные версии и отсутствие повторной отправки по журналу BPMSoft.
Исполнитель: Специалист digital-коммуникаций.
Средства: Персональный компьютер; BPMSoft; Рекламный кабинет.
Входы: Согласованные рекламные материалы; Список клиентских контактов; Подтверждения готовности магазинов.
Результаты: Параметры цифровых размещений; Подготовленные email-сообщения; Список адресатов рассылки; Инструкции для магазинов; Подтверждения готовности каналов; Рекламные материалы, переданные магазинам.
Основания: Согласованный электронный медиаплан; Технические требования каналов размещения; Требования к рекламе; Требования к обработке персональных данных; Требования к информации о товарах; Решение в BPMSoft; Данные мониторинга BPMSoft.</bpmn:documentation>
      <bpmn:incoming>A3_F2</bpmn:incoming>
      <bpmn:outgoing>A3_F8</bpmn:outgoing>
      <bpmn:ioSpecification id="A3_T31d_IO">
        <bpmn:dataInput id="A3_Data_1_Item" name="Согласованные материалы [вход из A2]"/>
        <bpmn:dataInput id="A3_Data_24_Item" name="Клиентские контакты BPMSoft"/>
        <bpmn:dataInput id="A3_Data_30_Item" name="Карточки и материалы BPMSoft"/>
        <bpmn:dataOutput id="A3_Data_4_Item" name="Список адресатов рассылки"/>
        <bpmn:dataOutput id="A3_Data_6_Item" name="Подготовленные email-сообщения"/>
        <bpmn:dataOutput id="A3_Data_8_Item" name="Параметры цифровых размещений"/>
        <bpmn:inputSet id="A3_T31d_InputSet">
          <bpmn:dataInputRefs>A3_Data_1_Item</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>A3_Data_24_Item</bpmn:dataInputRefs>
